  "history": {
    "archiveDirectory": "${LOG_DIR}/archive",
    "archiveFilenamePattern": "cntools-history.log_<epoch-seconds>",
    "retainedArchiveCount": 10,
    "fileMode": "umask-derived",
    "modeProbe": { "umask": "027", "expectedMode": "640" }
  },
  "blocklog": {
    "schemaVersion": 1,
    "tables": {
      "blocklog": ["id", "slot", "at", "epoch", "block", "slot_in_epoch", "hash", "size", "status"],
      "epochdata": ["id", "epoch", "epoch_nonce", "pool_id", "sigma", "d", "epoch_slots_ideal", "max_performance", "active_stake", "total_active_stake"],
      "replaylog": ["id", "event", "at", "env", "slot", "tip"],
      "statistics": ["id", "event", "start", "end", "env"],
      "validationlog": ["id", "event", "at", "env", "final_chunk", "initial_chunk"]
    },
    "namedIndexes": [
      "idx_blocklog_epoch",
      "idx_blocklog_slot",
      "idx_blocklog_status",
      "idx_epochdata_epoch",
      "idx_epochdata_pool_id"
    ],
    "fileMode": "umask-derived",
    "modeProbe": { "umask": "027", "expectedMode": "640" }
  },
  "modeContracts": [
    { "operation": "lockFile", "target": "individual artifact", "mode": "400", "dynamicProbe": true },
    { "operation": "unlockFile", "target": "individual artifact", "mode": "600", "dynamicProbe": true },
    { "operation": "wallet/pool/policy create or import", "target": "files in selected artifact directory", "mode": "600", "dynamicProbe": false },
    { "operation": "wallet/pool/policy encrypt", "target": "files in selected artifact directory", "mode": "400", "dynamicProbe": false },
    { "operation": "wallet/pool/policy decrypt", "target": "files in selected artifact directory", "mode": "600", "dynamicProbe": false },
    { "operation": "rotatePoolKeys", "target": "all pool files", "mode": "700", "dynamicProbe": false }
  ],
  "sourceAnchors": [
    { "id": "wallet-root", "file": "scripts/common-helper-scripts/lib/env.library", "needle": "WALLET_FOLDER=\"${CNODE_HOME}/priv/wallet\"", "minimumMatches": 1 },
    { "id": "pool-root", "file": "scripts/common-helper-scripts/lib/env.library", "needle": "POOL_FOLDER=\"${CNODE_HOME}/priv/pool\"", "minimumMatches": 1 },
    { "id": "asset-root", "file": "scripts/common-helper-scripts/lib/env.library", "needle": "ASSET_FOLDER=\"${CNODE_HOME}/priv/asset\"", "minimumMatches": 1 },
    { "id": "runtime-temp-suffix", "file": "scripts/common-helper-scripts/cntools.library", "needle": "TMP_DIR=\"${TMP_DIR}/cntools\"", "minimumMatches": 1 },
    { "id": "history-path", "file": "scripts/common-helper-scripts/cntools.library", "needle": "CNTOOLS_LOG=\"${LOG_DIR}/cntools-history.log\"", "minimumMatches": 1 },
    { "id": "history-archive-directory", "file": "scripts/common-helper-scripts/cntools.library", "needle": "log_archive=\"$(dirname \"${CNTOOLS_LOG}\")/archive\"", "minimumMatches": 1 },
    { "id": "history-archive-name", "file": "scripts/common-helper-scripts/cntools.library", "needle": "${log_archive}/${log_file}_$(date +%s)", "minimumMatches": 1 },
    { "id": "history-retention", "file": "scripts/common-helper-scripts/cntools.library", "needle": "head -n -10", "minimumMatches": 1 },
    { "id": "lock-file-mode", "file": "scripts/common-helper-scripts/cntools.library", "needle": "chmod 400 \"$1\"", "minimumMatches": 1 },
    { "id": "unlock-file-mode", "file": "scripts/common-helper-scripts/cntools.library", "needle": "chmod 600 \"${1}\"", "minimumMatches": 1 },
    { "id": "wallet-create-stage-mode", "file": "scripts/common-helper-scripts/cntools.library", "needle": "\"${_wmh_tools[chmod]}\" 0600 \"${_wmh_path}\"", "minimumMatches": 1 },
    { "id": "pool-create-mode", "file": "scripts/common-helper-scripts/cntools.sh", "needle": "chmod 600 \"${POOL_FOLDER}/${pool_name}/\"*", "minimumMatches": 3 },
    { "id": "asset-policy-create-mode", "file": "scripts/common-helper-scripts/cntools/modules/root/advanced/asset/create-policy/action.sh", "needle": "\"${asset_create_chmod_path}\" 0600 \"${asset_create_policy_vk_file}\"", "minimumMatches": 1 },
    { "id": "cleanup-retention", "file": "scripts/common-helper-scripts/cntools.sh", "needle": "-name \"offline_tx*\" -o -name \"*_cntools_backup*\" -o -name \"metadata_*\" -o -name \"asset*\"", "minimumMatches": 1 },
    { "id": "offline-transaction-output", "file": "scripts/common-helper-scripts/cntools.library", "needle": "offline_tx=\"${TMP_DIR}/offline_tx_$(jq -r .id <<< ${offlineJSON}).json\"", "minimumMatches": 10 },
    { "id": "backup-direct-child-selection", "file": "scripts/common-helper-scripts/cntools.sh", "needle": "find \"${item}\" -mindepth 1 -maxdepth 1 -type d -print0", "minimumMatches": 3 },
    { "id": "online-backup-name", "file": "scripts/common-helper-scripts/cntools.sh", "needle": "online_cntools_backup-", "minimumMatches": 1 },
