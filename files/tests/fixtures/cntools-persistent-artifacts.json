{
  "schemaVersion": 1,
  "contract": "cntools-legacy-persistent-artifacts",
  "description": "Characterization contract for CNTools data that survives a menu action or is intended for backup. This records observed legacy behavior; it is not a recommendation that every behavior be retained indefinitely.",
  "roots": {
    "wallet": "${CNODE_HOME}/priv/wallet",
    "pool": "${CNODE_HOME}/priv/pool",
    "asset": "${CNODE_HOME}/priv/asset",
    "history": "${CNODE_HOME}/logs/cntools-history.log",
    "temporaryBase": "/tmp/${CNODE_HOME_BASENAME}",
    "temporaryRuntime": "${TMP_DIR}/cntools",
    "blocklogDirectory": "${CNODE_HOME}/guild-db/blocklog",
    "blocklogDatabase": "${BLOCKLOG_DIR}/blocklog.db",
    "preRestoreArchive": "${CNODE_HOME}/priv/archive"
  },
  "filenameDefaults": {
    "wallet": [
      { "variable": "WALLET_PAY_VK_FILENAME", "value": "payment.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_PAY_SK_FILENAME", "value": "payment.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_HW_PAY_SK_FILENAME", "value": "payment.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "WALLET_PAY_ADDR_FILENAME", "value": "payment.addr", "role": "address", "signingMaterial": false },
      { "variable": "WALLET_PAY_SCRIPT_FILENAME", "value": "payment.script", "role": "script", "signingMaterial": false },
      { "variable": "WALLET_PAY_CRED_FILENAME", "value": "payment.cred", "role": "credential", "signingMaterial": false },
      { "variable": "WALLET_PAY_SCRIPT_CRED_FILENAME", "value": "payment.script.cred", "role": "script-credential", "signingMaterial": false },
      { "variable": "WALLET_BASE_ADDR_FILENAME", "value": "base.addr", "role": "address", "signingMaterial": false },
      { "variable": "WALLET_STAKE_VK_FILENAME", "value": "stake.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_STAKE_SK_FILENAME", "value": "stake.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_HW_STAKE_SK_FILENAME", "value": "stake.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "WALLET_STAKE_ADDR_FILENAME", "value": "reward.addr", "role": "address", "signingMaterial": false },
      { "variable": "WALLET_STAKE_SCRIPT_FILENAME", "value": "stake.script", "role": "script", "signingMaterial": false },
      { "variable": "WALLET_STAKE_CRED_FILENAME", "value": "stake.cred", "role": "credential", "signingMaterial": false },
      { "variable": "WALLET_STAKE_SCRIPT_CRED_FILENAME", "value": "stake.script.cred", "role": "script-credential", "signingMaterial": false },
      { "variable": "WALLET_STAKE_CERT_FILENAME", "value": "stake.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_STAKE_DEREG_FILENAME", "value": "stake.dereg", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_DELEGCERT_FILENAME", "value": "delegation.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_CATALYST_VK_FILENAME", "value": "catalyst.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_CATALYST_SK_FILENAME", "value": "catalyst.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_CATALYST_QR_FILENAME", "value": "catalyst-qrcode.png", "role": "image", "signingMaterial": false },
      { "variable": "WALLET_GOV_DREP_VK_FILENAME", "value": "drep.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_GOV_DREP_SK_FILENAME", "value": "drep.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_GOV_DREP_ID_FILENAME", "value": "drep.id", "role": "identifier", "signingMaterial": false },
      { "variable": "WALLET_GOV_DREP_SCRIPT_FILENAME", "value": "drep.script", "role": "script", "signingMaterial": false },
      { "variable": "WALLET_GOV_DREP_REGISTER_CERT_FILENAME", "value": "drep-reg.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_GOV_DREP_RETIRE_CERT_FILENAME", "value": "drep-ret.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_GOV_VOTE_DELEG_CERT_FILENAME", "value": "vote-deleg.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "WALLET_GOV_HW_DREP_SK_FILENAME", "value": "drep.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "WALLET_GOV_CC_HOT_VK_FILENAME", "value": "cc-hot.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_GOV_CC_HOT_SK_FILENAME", "value": "cc-hot.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_GOV_HW_CC_HOT_SK_FILENAME", "value": "cc-hot.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "WALLET_GOV_CC_HOT_ID_FILENAME", "value": "cc-hot.id", "role": "identifier", "signingMaterial": false },
      { "variable": "WALLET_GOV_CC_COLD_VK_FILENAME", "value": "cc-cold.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "WALLET_GOV_CC_COLD_SK_FILENAME", "value": "cc-cold.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "WALLET_GOV_HW_CC_COLD_SK_FILENAME", "value": "cc-cold.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "WALLET_GOV_CC_COLD_ID_FILENAME", "value": "cc-cold.id", "role": "identifier", "signingMaterial": false },
      { "variable": "WALLET_DERIVATION_PATH_FILENAME", "value": "derivation.path", "role": "derivation-metadata", "signingMaterial": false }
    ],
    "pool": [
      { "variable": "POOL_ID_FILENAME", "value": "pool.id", "role": "identifier", "signingMaterial": false },
      { "variable": "POOL_HOTKEY_VK_FILENAME", "value": "hot.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "POOL_HOTKEY_SK_FILENAME", "value": "hot.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "POOL_COLDKEY_VK_FILENAME", "value": "cold.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "POOL_COLDKEY_SK_FILENAME", "value": "cold.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "POOL_HW_COLDKEY_SK_FILENAME", "value": "cold.hwsfile", "role": "hardware-signing-file", "signingMaterial": true },
      { "variable": "POOL_OPCERT_COUNTER_FILENAME", "value": "cold.counter", "role": "counter", "signingMaterial": false },
      { "variable": "POOL_OPCERT_FILENAME", "value": "op.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "POOL_VRF_VK_FILENAME", "value": "vrf.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "POOL_VRF_SK_FILENAME", "value": "vrf.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "POOL_CONFIG_FILENAME", "value": "pool.config", "role": "configuration", "signingMaterial": false },
      { "variable": "POOL_REGCERT_FILENAME", "value": "pool.cert", "role": "certificate", "signingMaterial": false },
      { "variable": "POOL_CURRENT_KES_START", "value": "kes.start", "role": "counter", "signingMaterial": false },
      { "variable": "POOL_DEREGCERT_FILENAME", "value": "pool.dereg", "role": "certificate", "signingMaterial": false },
      { "variable": "POOL_CALIDUS_VK_FILENAME", "value": "calidus.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "POOL_CALIDUS_SK_FILENAME", "value": "calidus.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "POOL_CALIDUS_ID_FILENAME", "value": "calidus.id", "role": "identifier", "signingMaterial": false },
      { "variable": "POOL_CALIDUS_REG_FILENAME", "value": "calidus_reg.json", "role": "registration", "signingMaterial": false }
    ],
    "asset": [
      { "variable": "ASSET_POLICY_VK_FILENAME", "value": "policy.vkey", "role": "verification-key", "signingMaterial": false },
      { "variable": "ASSET_POLICY_SK_FILENAME", "value": "policy.skey", "role": "signing-key", "signingMaterial": true },
      { "variable": "ASSET_POLICY_SCRIPT_FILENAME", "value": "policy.script", "role": "script", "signingMaterial": false },
      { "variable": "ASSET_POLICY_ID_FILENAME", "value": "policy.id", "role": "identifier", "signingMaterial": false }
    ]
  },
  "derivedArtifacts": {
    "walletInstance": "${WALLET_FOLDER}/${wallet_name}",
    "poolInstance": "${POOL_FOLDER}/${pool_name}",
    "assetPolicyInstance": "${ASSET_FOLDER}/${policy_name}",
    "multisigPrefix": "ms_",
    "multisigSigningVariants": [
      "ms_payment.skey",
      "ms_payment.hwsfile",
      "ms_stake.skey",
      "ms_stake.hwsfile",
      "ms_drep.skey",
      "ms_drep.hwsfile"
    ],
    "additionalPoolFiles": [".hwtype", "poolmeta.json"],
    "additionalAssetFiles": ["${asset_name}.asset", "token-metadata-creator JSON"]
  },
  "transaction": {
    "runtimeArtifacts": [
      "${TMP_DIR}/tx.raw",
      "${TMP_DIR}/tx.raw_XXXXXXXXXX",
      "${TMP_DIR}/tx.witness_XXXXXXXXXX",
      "${TMP_DIR}/tx.signed_<epoch>",
      "${TMP_DIR}/tx.signed_XXXXXXXXXX",
      "${TMP_DIR}/offline_tx_<id>.json"
    ],
    "cleanupRetentionBasenamePatterns": [
      "protparams.json",
      ".dialogrc",
      "offline_tx*",
      "*_cntools_backup*",
      "metadata_*",
      "asset*"
    ],
    "cleanupSample": {
      "files": [
        ".dialogrc",
        "asset-mint.json",
        "incremental_cntools_backup-probe.tar.gz",
        "metadata_probe.json",
        "nested/tx.raw",
        "offline_tx_1700000000.json",
        "protparams.json",
        "random.tmp",
        "tx.raw",
        "tx.signed_1700000000",
        "tx.witness_0000000001"
      ],
      "expectedRetained": [
        ".dialogrc",
        "asset-mint.json",
        "incremental_cntools_backup-probe.tar.gz",
        "metadata_probe.json",
        "offline_tx_1700000000.json",
        "protparams.json"
      ],
      "expectedSelectedForDeletion": [
        "nested/tx.raw",
        "random.tmp",
        "tx.raw",
        "tx.signed_1700000000",
        "tx.witness_0000000001"
      ]
    },
    "offlineEnvelopeSample": {
      "id": "1700000000",
      "type": "payment",
      "date-created": "2023-11-14T22:13:20+00:00",
      "date-expire": "2023-11-14T23:13:20+00:00",
      "ttl": "1700003600",
      "signing-file": [],
      "script-file": [],
      "witness": []
    },
    "outputMode": "umask-derived"
  },
  "backupPolicy": {
    "sourceRoots": ["wallet", "pool", "asset"],
    "selection": "direct-child-directories-only",
    "rootLooseFilesIncluded": false,
    "onlineExcludedBasenames": [
      "cold.skey",
      "cold.skey.gpg",
      "payment.skey",
      "payment.skey.gpg",
      "policy.skey",
      "policy.skey.gpg",
      "stake.skey",
      "stake.skey.gpg"
    ],
    "offlineExcludedBasenames": [],
    "onlineOutputPattern": "online_cntools_backup-YYYYmmddHHMMSS.${CNODE_NAME}.tar.gz[.gpg]",
    "offlineOutputPattern": "offline_cntools_backup-YYYYmmddHHMMSS.${CNODE_NAME}.tar.gz[.gpg]",
    "wholeArchiveEncryptionOptional": true,
    "outputMode": "umask-derived",
    "modeProbe": { "umask": "027", "expectedMode": "640" },
