FROM debian:stable-slim

# The deployment manifest makes implementation and network authoritative for
# the lifetime of a target. Select both when the image is built.
ARG DEBIAN_FRONTEND=noninteractive
ARG G_ACCOUNT=cardano-community
ARG GUILD_DEPLOY_BRANCH=master
ARG NODE_IMPLEMENTATION=cnode
ARG NODE_NETWORK=mainnet

# DEFINE THE PREFERRED STOP SIGNAL
STOPSIGNAL SIGINT

LABEL desc="Cardano node deployed with Guild Operators"

USER root
WORKDIR /

ENV \
    ENV=/etc/profile \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    USER_HOME=/home/guild \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    UPDATE_CHECK=N \
    SUDO=N

# Keep immutable image identity separate from the compatibility variables that
# operators may already pass to containers.
ENV \
    IMAGE_NODE_IMPLEMENTATION=${NODE_IMPLEMENTATION} \
    IMAGE_NODE_NETWORK=${NODE_NETWORK} \
    IMAGE_NODE_HOME=/opt/cardano/${NODE_IMPLEMENTATION}
ENV \
    NODE_IMPLEMENTATION=${IMAGE_NODE_IMPLEMENTATION} \
    NODE_NETWORK=${IMAGE_NODE_NETWORK} \
    NETWORK=${IMAGE_NODE_NETWORK} \
    NODE_HOME=${IMAGE_NODE_HOME} \
    CNODE_HOME=${IMAGE_NODE_HOME} \
    AMARU_STATE_ROOT=/var/lib/amaru \
    HOME=${USER_HOME} \
    PATH=${IMAGE_NODE_HOME}/scripts:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:${USER_HOME}/.local/bin
ENV CARDANO_NODE_SOCKET_PATH=${IMAGE_NODE_HOME}/sockets/node.socket

RUN case "${IMAGE_NODE_IMPLEMENTATION}:${IMAGE_NODE_NETWORK}" in \
      cnode:mainnet|cnode:guild|cnode:preprod|cnode:preview|dingo:preprod|dingo:preview|amaru:preprod|amaru:preview) ;; \
      *) echo "Unsupported Docker deployment: ${IMAGE_NODE_IMPLEMENTATION}:${IMAGE_NODE_NETWORK}" >&2; exit 1 ;; \
    esac

RUN apt-get update \
    && apt-get install --no-install-recommends -y locales apt-utils curl git wget udev jq ca-certificates \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && useradd -m -U -s /bin/bash -c '' guild \
    && passwd -l guild \
    && mkdir -p "${USER_HOME}/.local/bin" "${USER_HOME}/.scripts" /conf /var/lib/amaru \
    && chown guild:guild /var/lib/amaru

# Install prerequisites first, then the selected node and its supported helper
# set. cnode retains the historical full Docker payload; Dingo and Amaru use
# their smaller experimental payloads accepted by their deployment profiles.
RUN set -x \
    && wget -O /guild-deploy.sh \
      "https://raw.githubusercontent.com/${G_ACCOUNT}/guild-operators/${GUILD_DEPLOY_BRANCH}/scripts/cnode-helper-scripts/guild-deploy.sh" \
    && chmod 0755 /guild-deploy.sh \
    && export CNODE_SKIP_DBSYNC_DOWNLOAD=Y G_ACCOUNT="${G_ACCOUNT}" \
    && /guild-deploy.sh \
      -i "${IMAGE_NODE_IMPLEMENTATION}" \
      -n "${IMAGE_NODE_NETWORK}" \
      -b "${GUILD_DEPLOY_BRANCH}" \
      -s p \
    && case "${IMAGE_NODE_IMPLEMENTATION}" in \
      cnode) install_flags=dcmowx ;; \
      dingo|amaru) install_flags=dfs ;; \
    esac \
    && "${IMAGE_NODE_HOME}/scripts/guild-deploy.sh" \
      -i "${IMAGE_NODE_IMPLEMENTATION}" \
      -n "${IMAGE_NODE_NETWORK}" \
      -b "${GUILD_DEPLOY_BRANCH}" \
      -s "${install_flags}" \
    && source_repository="$(jq -er '.repository' "${IMAGE_NODE_HOME}/.deployment.json")" \
    && source_branch="$(jq -er '.branch' "${IMAGE_NODE_HOME}/.deployment.json")" \
    && source_revision="$(jq -er '.sourceRevision' "${IMAGE_NODE_HOME}/.deployment.json")" \
    && source_account="${source_repository%/guild-operators}" \
    && test "${source_repository}" = "${source_account}/guild-operators" \
    && git clone --quiet --depth 1 --single-branch --no-tags \
      --branch "${source_branch}" \
      "https://github.com/${source_account}/guild-operators.git" \
      /guild-container-source \
    && test "$(git -C /guild-container-source rev-parse HEAD)" = "${source_revision}" \
    && install -m 0644 \
      /guild-container-source/files/docker/node/addons/banner.txt \
      "${USER_HOME}/.scripts/banner.txt" \
    && install -m 0755 \
      /guild-container-source/files/docker/node/addons/healthcheck.sh \
      "${IMAGE_NODE_HOME}/scripts/healthcheck.sh" \
    && install -m 0755 \
      /guild-container-source/files/docker/node/addons/entrypoint.sh \
      "${USER_HOME}/entrypoint.sh" \
    && if [ "${IMAGE_NODE_IMPLEMENTATION}" = "cnode" ]; then \
      mkdir -p "/conf/${IMAGE_NODE_NETWORK}" \
      && cp \
        "${IMAGE_NODE_HOME}/files/alonzo-genesis.json" \
        "${IMAGE_NODE_HOME}/files/byron-genesis.json" \
        "${IMAGE_NODE_HOME}/files/conway-genesis.json" \
        "${IMAGE_NODE_HOME}/files/shelley-genesis.json" \
        "${IMAGE_NODE_HOME}/files/config.json" \
        "${IMAGE_NODE_HOME}/files/dbsync.json" \
        "${IMAGE_NODE_HOME}/files/topology.json" \
        "/conf/${IMAGE_NODE_NETWORK}/" \
      && install -m 0755 \
        /guild-container-source/files/docker/node/addons/block_watcher.sh \
        "${USER_HOME}/.scripts/block_watcher.sh"; \
    fi \
    && rm -rf /guild-container-source \
    && mkdir -p "${IMAGE_NODE_HOME}/priv/files" \
    && chmod -R a+rX /conf \
    && chown -R guild:guild "${IMAGE_NODE_HOME}" "${USER_HOME}" /conf \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/*

# Runtime tools used by the launchers and the implementation-aware healthcheck.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      procps libcap2 libselinux1 libc6 ncurses-bin iproute2 xz-utils netbase \
      coreutils dnsutils net-tools tcptraceroute bc usbip sqlite3 python3 tmux \
      ncurses-base libtool autoconf util-linux less openssl bsdmainutils dialog \
      vim socat \
    && if [ "${IMAGE_NODE_IMPLEMENTATION}" = "cnode" ]; then \
      apt-get install --no-install-recommends -y libsodium-dev; \
    fi \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/*

USER guild
WORKDIR ${USER_HOME}

RUN jq -er '.sourceRevision' "${IMAGE_NODE_HOME}/.deployment.json" \
      > "${USER_HOME}/guild-latest.txt" \
    && echo "head -n 8 ${USER_HOME}/.scripts/banner.txt" >> "${USER_HOME}/.bashrc" \
    && echo "grep MENU -A 6 ${USER_HOME}/.scripts/banner.txt | grep -v MENU" >> "${USER_HOME}/.bashrc" \
    && echo "alias env=/usr/bin/env" >> "${USER_HOME}/.bashrc" \
    && echo "alias node=${IMAGE_NODE_HOME}/scripts/${IMAGE_NODE_IMPLEMENTATION}.sh" >> "${USER_HOME}/.bashrc" \
    && echo "alias gLiveView=${IMAGE_NODE_HOME}/scripts/gLiveView.sh" >> "${USER_HOME}/.bashrc" \
    && if [ "${IMAGE_NODE_IMPLEMENTATION}" = "cnode" ] || [ "${IMAGE_NODE_IMPLEMENTATION}" = "dingo" ]; then \
      echo "alias cntools=${IMAGE_NODE_HOME}/scripts/cntools.sh" >> "${USER_HOME}/.bashrc"; \
    fi \
    && echo "export PATH=${IMAGE_NODE_HOME}/scripts:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:${USER_HOME}/.local/bin" >> "${USER_HOME}/.bashrc" \
    && echo "alias ll='ls -alhF'" >> "${USER_HOME}/.bashrc"

HEALTHCHECK --start-period=5m --interval=120s --timeout=120s CMD ${IMAGE_NODE_HOME}/scripts/healthcheck.sh

ENTRYPOINT ["./entrypoint.sh"]
