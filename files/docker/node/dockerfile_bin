FROM debian:stable-slim

# The deployment manifest makes implementation and network authoritative for
# the lifetime of a target. Select both when the image is built.
ARG DEBIAN_FRONTEND=noninteractive
ARG G_ACCOUNT=cardano-community
ARG GUILD_DEPLOY_BRANCH=master
ARG GUILD_DEPLOY_REVISION=
ARG NODE_IMPLEMENTATION=cnode
ARG NODE_NETWORK=mainnet

# DEFINE THE PREFERRED STOP SIGNAL
STOPSIGNAL SIGINT

LABEL desc="Cardano node deployed with Guild Operators"

USER root
WORKDIR /

ENV \
    ENV=/etc/profile \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    USER_HOME=/home/guild \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    UPDATE_CHECK=N \
    ENABLE_CHATTR=false \
    ENABLE_DIALOG=false \
    SUDO=N

# Keep immutable image identity separate from the compatibility variables that
# operators may already pass to containers.
ENV \
    IMAGE_NODE_IMPLEMENTATION=${NODE_IMPLEMENTATION} \
    IMAGE_NODE_NETWORK=${NODE_NETWORK} \
    IMAGE_NODE_HOME=/opt/cardano/${NODE_IMPLEMENTATION}
ENV \
    NODE_IMPLEMENTATION=${IMAGE_NODE_IMPLEMENTATION} \
    NODE_NETWORK=${IMAGE_NODE_NETWORK} \
    NETWORK=${IMAGE_NODE_NETWORK} \
    NODE_HOME=${IMAGE_NODE_HOME} \
    CNODE_HOME=${IMAGE_NODE_HOME} \
    AMARU_STATE_ROOT=/var/lib/amaru \
    HOME=${USER_HOME} \
    PATH=${IMAGE_NODE_HOME}/scripts:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:${USER_HOME}/.local/bin
ENV CARDANO_NODE_SOCKET_PATH=${IMAGE_NODE_HOME}/sockets/node.socket

RUN case "${IMAGE_NODE_IMPLEMENTATION}:${IMAGE_NODE_NETWORK}" in \
      cnode:mainnet|cnode:guild|cnode:preprod|cnode:preview|dingo:preprod|dingo:preview|amaru:preprod|amaru:preview) ;; \
      *) echo "Unsupported Docker deployment: ${IMAGE_NODE_IMPLEMENTATION}:${IMAGE_NODE_NETWORK}" >&2; exit 1 ;; \
    esac

RUN apt-get update \
    && apt-get install --no-install-recommends -y locales apt-utils curl wget udev jq ca-certificates git \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && useradd -m -U -s /bin/bash -c '' guild \
    && passwd -l guild \
    && mkdir -p "${USER_HOME}/.cache" "${USER_HOME}/.local/bin" "${USER_HOME}/.scripts" /conf /var/lib/amaru \
    && chown guild:guild /var/lib/amaru

# The build-context dispatcher is only a bootstrap seed. It prepares one
# managed Git snapshot, hands execution to that snapshot's dispatcher, and the
# complete node plus separately receipted Docker supplement comes from that
# single revision.
COPY scripts/cnode-helper-scripts/guild-deploy.sh /guild-deploy.sh

RUN set -eux \
    && chmod 0755 /guild-deploy.sh \
    && if ! printf '%s\n' "${GUILD_DEPLOY_REVISION}" \
      | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$'; then \
        printf '%s\n' \
          'GUILD_DEPLOY_REVISION must be a full lowercase SHA-1 or SHA-256 commit ID.' >&2; \
        exit 1; \
      fi \
    && docker_export=/var/tmp/guild-docker-export \
    && case "${IMAGE_NODE_IMPLEMENTATION}" in \
      cnode) install_flags=dcmowx ;; \
      dingo|amaru) install_flags=dfs ;; \
    esac \
    && export CNODE_SKIP_DBSYNC_DOWNLOAD=Y CNODE_SKIP_HW_UDEV_RULES=Y \
      G_ACCOUNT="${G_ACCOUNT}" \
      GUILD_SOURCE_CACHE_ROOT=/var/cache/guild-operators \
      GUILD_SOURCE_EXPECT_REVISION="${GUILD_DEPLOY_REVISION}" \
    && /guild-deploy.sh \
      -i "${IMAGE_NODE_IMPLEMENTATION}" \
      -n "${IMAGE_NODE_NETWORK}" \
      -a "${G_ACCOUNT}" \
      -b "${GUILD_DEPLOY_BRANCH}" \
      -S managed \
      -s "p${install_flags}" \
      -E "${docker_export}" \
    && source_revision="$(jq -er '.sourceRevision' "${IMAGE_NODE_HOME}/.deployment.json")" \
    && [ "${source_revision}" = "${GUILD_DEPLOY_REVISION}" ] \
    && cp -a "${docker_export}/rootfs/." / \
    && mkdir -p /usr/share/guild-operators \
    && install -m 0644 "${docker_export}/docker-source-receipt.json" \
      /usr/share/guild-operators/docker-source-receipt.json \
    && install -m 0644 "${docker_export}/docker-source-receipt.sha256" \
      /usr/share/guild-operators/docker-source-receipt.sha256 \
    && host_receipt_hash="$(sha256sum "${IMAGE_NODE_HOME}/.guild-source-receipt.json" | awk '{print $1}')" \
    && jq -e --arg revision "${source_revision}" --arg host_hash "${host_receipt_hash}" \
      '.source.revision == $revision and .hostPayloadReceiptSha256 == $host_hash' \
      /usr/share/guild-operators/docker-source-receipt.json >/dev/null \
    && (cd /usr/share/guild-operators && sha256sum -c docker-source-receipt.sha256) \
    && receipt_files=/var/tmp/guild-docker-receipt-files.tsv \
    && jq -er ' \
      def valid_file: \
        type == "object" and \
        keys == ["exportedSha256", "mode", "path", "source", "sourceSha256"] and \
        (.source | type == "string" and test("^(scripts|files)/")) and \
        (.path | type == "string" and \
          test("^/[A-Za-z0-9._/+@:-]+$") and \
          (contains("//") | not) and \
          ((contains("\t") or contains("\r") or contains("\n")) | not) and \
          (split("/") | all(. != "." and . != ".."))) and \
        (.mode == "0644" or .mode == "0755") and \
        (.sourceSha256 | type == "string" and test("^[0-9a-f]{64}$")) and \
        (.exportedSha256 == .sourceSha256); \
      if ((.files | type == "array" and length > 0) and \
          all(.files[]; valid_file) and \
          ((.files | map(.path) | length) == \
           (.files | map(.path) | unique | length))) \
      then .files[] | [.path, .mode, .exportedSha256] | @tsv \
      else error("invalid or empty Docker supplement file inventory") \
      end \
    ' /usr/share/guild-operators/docker-source-receipt.json > "${receipt_files}" \
    && [ -s "${receipt_files}" ] \
    && while IFS="$(printf '\t')" read -r final_path final_mode final_hash; do \
          [ -f "${final_path}" ] && [ ! -L "${final_path}" ] || exit 1; \
          [ "$(sha256sum "${final_path}" | awk '{print $1}')" = "${final_hash}" ] || exit 1; \
          [ "$(stat -c '%a' "${final_path}")" = "${final_mode#0}" ] || exit 1; \
        done < "${receipt_files}" \
    && printf '%s\n' "${source_revision}" > "${USER_HOME}/guild-latest.txt" \
    && mkdir -p "${IMAGE_NODE_HOME}/priv/files" \
    && chmod -R a+rX /conf \
    && chown -R guild:guild "${IMAGE_NODE_HOME}" "${USER_HOME}" /conf \
    && rm -rf /var/cache/guild-operators "${docker_export}" "${receipt_files}" \
    && rm -f /guild-deploy.sh \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/*

# Runtime tools used by the launchers and the implementation-aware healthcheck.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      procps libcap2 libselinux1 libc6 ncurses-bin iproute2 xz-utils netbase \
      coreutils dnsutils net-tools tcptraceroute bc usbip sqlite3 python3 tmux \
      ncurses-base libtool autoconf util-linux less openssl bsdmainutils dialog \
      vim socat \
    && if [ "${IMAGE_NODE_IMPLEMENTATION}" = "cnode" ]; then \
      apt-get install --no-install-recommends -y libsodium-dev; \
    fi \
    && apt-get -y clean \
    && rm -rf /var/lib/apt/lists/*

USER guild
WORKDIR ${USER_HOME}

RUN echo "head -n 8 ${USER_HOME}/.scripts/banner.txt" >> "${USER_HOME}/.bashrc" \
    && echo "grep MENU -A 6 ${USER_HOME}/.scripts/banner.txt | grep -v MENU" >> "${USER_HOME}/.bashrc" \
    && echo "alias env=/usr/bin/env" >> "${USER_HOME}/.bashrc" \
    && echo "alias node=${IMAGE_NODE_HOME}/scripts/${IMAGE_NODE_IMPLEMENTATION}.sh" >> "${USER_HOME}/.bashrc" \
    && echo "alias gLiveView=${IMAGE_NODE_HOME}/scripts/gLiveView.sh" >> "${USER_HOME}/.bashrc" \
    && if [ "${IMAGE_NODE_IMPLEMENTATION}" = "cnode" ] || [ "${IMAGE_NODE_IMPLEMENTATION}" = "dingo" ]; then \
      echo "alias cntools=${IMAGE_NODE_HOME}/scripts/cntools.sh" >> "${USER_HOME}/.bashrc"; \
    fi \
    && echo "export PATH=${IMAGE_NODE_HOME}/scripts:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:${USER_HOME}/.local/bin" >> "${USER_HOME}/.bashrc" \
    && echo "alias ll='ls -alhF'" >> "${USER_HOME}/.bashrc"

HEALTHCHECK --start-period=5m --interval=120s --timeout=120s CMD ${IMAGE_NODE_HOME}/scripts/healthcheck.sh

ENTRYPOINT ["./entrypoint.sh"]
