# Guild Operators Dingo profile: preview
GUILD_NODE_IMPLEMENTATION="dingo"
GUILD_NODE_HOME="@NODE_HOME@"
GUILD_NODE_SERVICE="@NODE_SERVICE@"
DINGO_BIN="@BINARY_PATH@"
CARDANO_NETWORK="preview"
CARDANO_DATABASE_PATH="@NODE_HOME@/db"
CARDANO_SOCKET_PATH="@NODE_HOME@/sockets/dingo.socket"
DINGO_STORAGE_MODE="core"
DINGO_RUN_MODE="serve"
DINGO_LOGGING_FORMAT="text"
DINGO_LOGGING_LEVEL="info"
DINGO_CONFIG="@NODE_HOME@/files/dingo.yaml"

# Set POOL_NAME to the subfolder containing this pool's operational hot keys.
# Dingo runs as a block producer only when hot.skey, vrf.skey, and op.cert are
# all present in POOL_DIR. Otherwise it runs as a relay.
POOL_FOLDER="${POOL_FOLDER:-@NODE_HOME@/priv/pool}"
POOL_NAME="${POOL_NAME:-CHANGE_ME}"
POOL_DIR="${POOL_DIR:-${POOL_FOLDER}/${POOL_NAME}}"
