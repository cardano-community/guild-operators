# Guild Operators Dingo profile: mainnet
# Dingo is experimental and runs here as a relay only. It is still under heavy
# development: try it on preview or preprod first. Running it on mainnet is at
# your own responsibility.
GUILD_NODE_IMPLEMENTATION="dingo"
GUILD_NODE_HOME="@NODE_HOME@"
GUILD_NODE_SERVICE="@NODE_SERVICE@"
DINGO_BIN="@BINARY_PATH@"
CARDANO_NETWORK="mainnet"
CARDANO_DATABASE_PATH="@NODE_HOME@/db"
CARDANO_SOCKET_PATH="@NODE_HOME@/sockets/dingo.socket"
DINGO_STORAGE_MODE="core"
DINGO_RUN_MODE="serve"
DINGO_LOGGING_FORMAT="text"
DINGO_LOGGING_LEVEL="info"
DINGO_CONFIG="@NODE_HOME@/files/dingo.yaml"

# Optional Bearer token for the Prometheus listener. gLiveView and the Docker
# health check read it from here. Required before binding metrics off loopback.
#DINGO_METRICS_AUTH_TOKEN=""

# Dingo block production is limited to preprod and preview. On mainnet the
# launcher refuses to start while any operational hot key (hot.skey, vrf.skey
# or op.cert) is present in POOL_DIR, so keep pool keys out of this deployment.
POOL_FOLDER="${POOL_FOLDER:-@NODE_HOME@/priv/pool}"
POOL_NAME="${POOL_NAME:-CHANGE_ME}"
POOL_DIR="${POOL_DIR:-${POOL_FOLDER}/${POOL_NAME}}"
