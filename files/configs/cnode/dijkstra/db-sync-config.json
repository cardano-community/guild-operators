{
  "EnableFutureGenesis": true,
  "EnableLogMetrics": false,
  "EnableLogging": true,
  "NetworkName": "dijkstra",
  "NodeConfigFile": "/opt/cardano/cnode/files/config.json",
  "PrometheusPort": 8080,
  "RequiresNetworkMagic": "RequiresMagic",
  "insert_options": {
    "tx_out": {
      "value": "consumed",
      "use_address_table": true
    },
    "ledger": "enable",
    "shelley": {
      "enable": true
    },
    "multi_asset": {
      "enable": true
    },
    "metadata": {
      "enable": true
    },
    "plutus": {
      "enable": true
    },
    "governance": "enable",
    "json_type": "text",
    "offchain_pool_data": "enable",
    "offchain_vote_data": "enable",
    "pool_stat": "enable",
    "tx_cbor": "enable"
  },
  "ledger_backend": "inmemory",
  "snapshot_interval": {
    "near_tip_epoch": 1216
  },
  "TraceOptions": {
    "": {
      "backends": [
        "Stdout HumanFormatUncoloured"
      ],
      "detail": "DNormal",
      "severity": "Info"
    },
    "Mux": {
      "severity": "Error"
    },
    "Subscription": {
      "severity": "Error"
    }
  }
}
