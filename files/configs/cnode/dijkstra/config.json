{
  "$schema": "https://raw.githubusercontent.com/IntersectMBO/cardano-config/v2/schemas/config.schema.json",
  "Configuration": {
    "Consensus": {
      "ConsensusMode": "GenesisMode"
    },
    "HermodTracing": {
      "TraceOptionForwarder": {
        "maxReconnectDelay": 30,
        "queueSize": 128
      },
      "TraceOptionMetricsPrefix": "cardano.node.metrics.",
      "TraceOptionNodeName": "cnode",
      "TraceOptionResourceFrequency": 1000,
      "TraceOptions": {
        "": {
          "backends": [
            "PrometheusSimple suffix 127.0.0.1 12798",
            "Stdout MachineFormat"
          ],
          "detail": "DNormal",
          "severity": "Notice"
        },
        "BlockFetch.Client.CompletedBlockFetch": {
          "maxFrequency": 4.0,
          "severity": "Info"
        },
        "BlockFetch.Client.SendFetchRequest": {
          "severity": "Info"
        },
        "BlockFetch.Decision": {
          "severity": "Info"
        },
        "ChainDB": {
          "severity": "Info"
        },
        "ChainDB.AddBlockEvent.AddBlockValidation": {
          "severity": "Silence"
        },
        "ChainDB.AddBlockEvent.AddBlockValidation.ValidCandidate": {
          "maxFrequency": 2.0
        },
        "ChainDB.AddBlockEvent.AddedBlockToQueue": {
          "maxFrequency": 2.0
        },
        "ChainDB.AddBlockEvent.AddedBlockToVolatileDB": {
          "maxFrequency": 2.0
        },
        "ChainDB.AddBlockEvent.AddedToCurrentChain": {
          "maxFrequency": 2.0
        },
        "ChainDB.AddBlockEvent.SwitchedToAFork": {
          "severity": "Info"
        },
        "ChainDB.CopyToImmutableDBEvent.CopiedBlockToImmutableDB": {
          "maxFrequency": 2.0
        },
        "ChainDB.ImmDbEvent": {
          "severity": "Warning"
        },
        "ChainDB.ImmDbEvent.ChunkValidation.ValidatedChunk": {
          "severity": "Info"
        },
        "ChainDB.LedgerEvent.Forker": {
          "severity": "Silence"
        },
        "ChainDB.LedgerEvent.Replay": {
          "maxFrequency": 0.0668,
          "severity": "Info"
        },
        "ChainSync.Client": {
          "severity": "Warning"
        },
        "ChainSync.Client.DownloadedHeader": {
          "maxFrequency": 14.0,
          "severity": "Info"
        },
        "Forge.Loop": {
          "severity": "Info"
        },
        "Forge.Loop.NodeNotLeader": {
          "severity": "Silence"
        },
        "Forge.Loop.StartLeadershipCheck": {
          "severity": "Silence"
        },
        "Forge.StateInfo": {
          "maxFrequency": 0.0002783,
          "severity": "Info"
        },
        "Mempool": {
          "severity": "Silence"
        },
        "Net.AcceptPolicy.ConnectionLimitResume": {
          "maxFrequency": 0.0167,
          "severity": "Info"
        },
        "Net.AcceptPolicy.ConnectionRateLimiting": {
          "maxFrequency": 0.0167,
          "severity": "Info"
        },
        "Net.ConnectionManager.Remote": {
          "severity": "Info"
        },
        "Net.ErrorPolicy": {
          "severity": "Info"
        },
        "Net.InboundGovernor": {
          "severity": "Warning"
        },
        "Net.InboundGovernor.Remote": {
          "severity": "Info"
        },
        "Net.InboundGovernor.Remote.InboundGovernorCounters": {
          "maxFrequency": 0.0167,
          "severity": "Info"
        },
        "Net.Mux.Remote": {
          "severity": "Info"
        },
        "Net.PeerSelection": {
          "severity": "Info"
        },
        "Net.PeerSelection.Actions.ConnectionError": {
          "severity": "Silence"
        },
        "Resources": {
          "maxFrequency": 0.0167,
          "severity": "Info"
        },
        "Startup": {
          "severity": "Info"
        }
      }
    },
    "Network": {
      "ExperimentalProtocolsEnabled": true,
      "MinBigLedgerPeersForTrustedState": 3
    },
    "Protocol": {
      "AlonzoGenesisFile": "/opt/cardano/cnode/files/alonzo-genesis.json",
      "AlonzoGenesisHash": "387a7c4880477ce7b128566fa7f9f9ed99ee04476084e9f6332b6d42d907faab",
      "ByronGenesisFile": "/opt/cardano/cnode/files/byron-genesis.json",
      "ByronGenesisHash": "245e5b28a31c6bc3e8b78f1223294ae09e57b6d2543b51aba7cf9dadff161238",
      "ConwayGenesisFile": "/opt/cardano/cnode/files/conway-genesis.json",
      "ConwayGenesisHash": "e18ab8efc363ad170142706723568f1520a57f0dc05354e1d458041da18a3704",
      "RequiresNetworkMagic": "RequiresMagic",
      "ShelleyGenesisFile": "/opt/cardano/cnode/files/shelley-genesis.json",
      "ShelleyGenesisHash": "b47eb627b52bf9cfe5ffd865658b47b5747a088d150a9c27216de374e836c385"
    },
    "Storage": {
      "LedgerDB": {
        "Backend": "V2InMemory",
        "QueryBatchSize": 100000,
        "Snapshots": {
          "Interval": 17280,
          "MaxDelay": 4320,
          "MinDelay": 300,
          "NumOfDiskSnapshots": 2,
          "Offset": 0
        }
      }
    },
    "Testing": {
      "DijkstraGenesisFile": "/opt/cardano/cnode/files/dijkstra-genesis.json",
      "DijkstraGenesisHash": "ad58e282eff1f48c241faf6319f88ed54843821627a6be69470f05d7904e4601",
      "ExperimentalHardForksEnabled": true,
      "TestAllegraHardForkAtEpoch": 0,
      "TestAlonzoHardForkAtEpoch": 0,
      "TestBabbageHardForkAtEpoch": 0,
      "TestConwayHardForkAtEpoch": 0,
      "TestMaryHardForkAtEpoch": 0,
      "TestShelleyHardForkAtEpoch": 0
    }
  },
  "MinNodeVersion": "11.2.0",
  "Version": 2
}
