# Guild Operators Amaru relay profile: preprod
# Amaru is experimental and currently supported here as a relay only.
GUILD_NODE_IMPLEMENTATION="amaru"
GUILD_NODE_HOME="@NODE_HOME@"
GUILD_NODE_SERVICE="@NODE_SERVICE@"
AMARU_BIN="@BINARY_PATH@"
AMARU_NETWORK="preprod"
AMARU_DB_CHAIN="@NODE_HOME@/chain"
AMARU_DB_LEDGER="@NODE_HOME@/ledger"
AMARU_DB_LEDGER_MAX_EXTRA_SNAPSHOTS="0"
# Let a newer release upgrade the chain database in place when upstream
# provides a migration. Releases without one still require a new bootstrap.
AMARU_DB_CHAIN_AUTOMATIC_MIGRATION="true"
AMARU_PEERS_LISTEN_ON="0.0.0.0:@NODE_PORT@"
AMARU_PEER="preprod-node.play.dev.cardano.org:3001"
AMARU_PEERS_MAX_UPSTREAM="3"
# Also caps accepted inbound connections; raise it for a busier public relay.
AMARU_PEERS_MAX_DOWNSTREAM="10"
AMARU_PID_EXPORT="@NODE_HOME@/runtime/amaru.pid"
AMARU_WITH_JSON_TRACES="false"
AMARU_LOG="error,amaru=info,amaru_pure_stage=warn"

# Amaru exports OTLP/gRPC. The local collector installed by Guild runs a
# host-safe form of Amaru's reference Prometheus bridge for gLiveView, which
# has no trace or log backend, so only metrics are exported.
AMARU_WITH_OPEN_TELEMETRY="metrics"
OTEL_SERVICE_NAME="amaru"
OTEL_SERVICE_INSTANCE_ID="@NODE_SERVICE@"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4317"
OTEL_METRIC_EXPORT_INTERVAL="2000"
AMARU_PROMETHEUS_URL="http://127.0.0.1:8889/metrics"

# Disabled by default. If enabled, bind to loopback or protect it with an
# authenticating TLS reverse proxy. Amaru's submit endpoint has no auth/TLS.
#AMARU_SUBMIT_API_LISTEN_ON="127.0.0.1:8090"
