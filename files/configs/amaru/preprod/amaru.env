# Guild Operators Amaru relay profile: preprod
# Amaru is experimental and currently supported here as a relay only.
GUILD_NODE_IMPLEMENTATION="amaru"
GUILD_NODE_HOME="@NODE_HOME@"
GUILD_NODE_SERVICE="@NODE_SERVICE@"
AMARU_BIN="@BINARY_PATH@"
AMARU_NETWORK="preprod"
AMARU_CHAIN_DIR="@NODE_HOME@/chain"
AMARU_LEDGER_DIR="@NODE_HOME@/ledger"
AMARU_LISTEN_ADDRESS="0.0.0.0:@NODE_PORT@"
AMARU_PEER_ADDRESS="preprod-node.play.dev.cardano.org:3001"
AMARU_UPSTREAM_PEERS="3"
AMARU_DOWNSTREAM_PEERS="10"
AMARU_MIGRATE_CHAIN_DB="false"
AMARU_MAX_EXTRA_LEDGER_SNAPSHOTS="0"
AMARU_PID_FILE="@NODE_HOME@/runtime/amaru.pid"
AMARU_WITH_JSON_TRACES="false"
AMARU_WITH_OPEN_TELEMETRY="true"
AMARU_LOG="error,amaru=info"

# Amaru exports metrics as OTLP/HTTP. The local collector installed by Guild
# runs a host-safe form of Amaru's reference Prometheus bridge for gLiveView.
OTEL_SERVICE_NAME="amaru"
OTEL_SERVICE_INSTANCE_ID="@NODE_SERVICE@"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4317"
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://127.0.0.1:4318/v1/metrics"
OTEL_METRIC_EXPORT_INTERVAL="2000"
AMARU_PROMETHEUS_URL="http://127.0.0.1:8889/metrics"

# Disabled by default. If enabled, bind to loopback or protect it with an
# authenticating TLS reverse proxy. Amaru's submit endpoint has no auth/TLS.
#AMARU_SUBMIT_API_ADDRESS="127.0.0.1:8090"
