############################################################
# Variables to keep counter for versions                   #
############################################################
# The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/)
# and this adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html)
# Major: Any considerable change in the code base, big feature, workflow or breaking change from previous version
# __CNTOOLS_LEGACY_LOGICAL_PREFIX_END__

# Transitional Stage 2 compatibility loader. The fixed content-addressed
# bundle is validated as a complete sibling tree before legacy initialization
# creates directories or mutates ambient state. This temporary helper removes
# itself after loading so the historical function inventory stays unchanged.
if \builtin declare -F __guild_cntools_legacy_bundle_6e40118f \
    >/dev/null 2>&1; then
  \builtin printf '%s\n' \
    'CNTools legacy bundle loader collides with an existing caller function.' >&2
  \builtin return 1
fi
__guild_cntools_legacy_bundle_6e40118f() {
  \builtin local operation="${1:-}"
  \builtin local facade_source="${BASH_SOURCE[0]}"
  \builtin local facade_dir="" bundle_root="" bundle_dir="" entry=""
  \builtin local member="" known_member="" candidate="" journal=""
  \builtin local node_home_physical="" installed_context="N"
  \builtin local member_count=0 member_index=0 actual_mode=""
  \builtin local expected_member_mode="" expected_bundle_mode=""
  \builtin local actual_size="" actual_sha="" canonical_id=""
  \builtin local aliases_enabled="N"
  \builtin local bundle_id="6e40118f106169924a372a9d98fbc946cfc5362fcd1cd5a3ff048ae9287d5d59"
  \builtin local logical_body_sha="f86a3753a2c4b2251a4bc2fcc4f8ac69b5ca42cf3c527979580f0d931641575a"
  \builtin local logical_body_size="357616"
  \builtin local -a members member_sizes member_hashes
  members=(
    010-common-dialog.sh
    020-terminal-selection-security.sh
    030-governance-query.sh
    040-address-wallet-query.sh
    050-wallet-create-registration.sh
    060-wallet-actions.sh
    070-pool-actions.sh
    080-metadata-assets.sh
    090-governance-actions.sh
    100-transaction-hardware-price.sh
  )
  member_sizes=(
    14532 31976 46236 38284 114081 18393 27577 17503 22753 22300
  )
  member_hashes=(
    5408355794fa187dbac5af7b66b956ab84216fd91ee4b6ec8bbe420b05fea8a7
    bb6f10e533f45cb90577e32d0d7a57ca86fe0c97d950938911be8eecec4a1460
    9e9179c73ccdd945c6ed6b7921038b7f6bc7679c4609af86565f7ad99ff8d519
    b23fdfec65fd7e991a3e46d2bef1d5c9ed09102e345cac7f3f5b75c761957df0
    2ff4b5f29674fb1cf65e5cda736c9e4f41af51adbe76b29fa5a41bb369f63fdc
    73f150b684713b6c64211ff8c900a6deedb90a4aa15afde85dae44b8af220db5
    689a52e0e8f18a30984cebda6ef29dd929b66fb4cdba7ff03f673debb6e25257
    1444e366a79483bdcd538b59e01f8a623e3c6b4bf4fe58f5deaedc53ec247c80
    91fd56011304f4528851f8cd3b241ca63393440a51faa5c5380a22081a146ec8
    237b3847db52432ff523c36c5ca7bcb08b437f8b8978389259789a70fee5071f
  )

  [[ "${operation}" == "preflight" || "${operation}" == "load" ]] ||
    \builtin return 1
  if [[ -n "${NODE_HOME:-}" ]]; then
    [[ "${NODE_HOME}" == /* && "${NODE_HOME}" != "/" &&
       -d "${NODE_HOME}" ]] || {
      \builtin printf 'CNTools NODE_HOME is not a usable absolute directory.\n' >&2
      \builtin return 1
    }
    node_home_physical="$(
      \builtin cd -P -- "${NODE_HOME}" >/dev/null 2>&1 && \builtin pwd -P
    )" || \builtin return 1
    journal="${node_home_physical}/.guild-deploy-transaction"
    [[ ! -e "${journal}" && ! -L "${journal}" ]] || {
      \builtin printf 'CNTools refuses to start with a deployment journal: %s\n' \
        "${journal}" >&2
      \builtin return 1
    }
  fi
  facade_dir="$(
    \builtin cd -P -- "$(\builtin command dirname -- "${facade_source}")" \
      >/dev/null 2>&1 && \builtin pwd -P
  )" || \builtin return 1
  if [[ -n "${node_home_physical}" &&
        ( "${facade_dir}" == "${node_home_physical}/scripts" ||
          "${facade_dir}" == "${node_home_physical}/scripts/.cntools/"* ) ]]; then
    installed_context="Y"
  fi
  bundle_root="${facade_dir}/cntools/libs/legacy"
  bundle_dir="${bundle_root}/${bundle_id}"
  for entry in \
    "${facade_dir}/cntools" \
    "${facade_dir}/cntools/libs" \
    "${bundle_root}" \
    "${bundle_dir}"; do
    [[ -d "${entry}" && ! -L "${entry}" && -O "${entry}" ]] || {
      \builtin printf 'CNTools legacy bundle directory is missing or unsafe: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
    actual_mode="$(\builtin command find "${entry}" -prune -printf '%m' \
      2>/dev/null || \builtin true)"
    [[ -n "${actual_mode}" ]] ||
      actual_mode="$(\builtin command stat -f '%Lp' "${entry}" \
        2>/dev/null || \builtin true)"
    actual_mode="${actual_mode#0}"
    case "${actual_mode}" in
      [0-7][0-7][0-7]) ;;
      *) \builtin return 1 ;;
    esac
    (( (8#${actual_mode} & 8#022) == 0 )) || {
      \builtin printf 'CNTools legacy bundle directory is writable by peers: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
  done
  actual_mode="$(\builtin command find "${bundle_dir}" -prune -printf '%m' \
    2>/dev/null || \builtin true)"
  [[ -n "${actual_mode}" ]] ||
    actual_mode="$(\builtin command stat -f '%Lp' "${bundle_dir}" \
      2>/dev/null || \builtin true)"
  actual_mode="${actual_mode#0}"
  if [[ "${installed_context}" == "Y" ]]; then
    expected_bundle_mode="555"
    expected_member_mode="444"
  elif [[ "${actual_mode}" == "755" ]]; then
    expected_bundle_mode="755"
    expected_member_mode="644"
  else
    expected_bundle_mode="555"
    expected_member_mode="444"
  fi
  [[ "${actual_mode}" == "${expected_bundle_mode}" ]] || {
    \builtin printf 'CNTools legacy bundle directory has invalid mode: %s\n' \
      "${bundle_dir}" >&2
    \builtin return 1
  }
  for member_index in "${!members[@]}"; do
    member="${members[member_index]}"
    entry="${bundle_dir}/${member}"
    [[ -f "${entry}" && ! -L "${entry}" && -O "${entry}" ]] || {
      \builtin printf 'CNTools legacy bundle member is missing or unsafe: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
    actual_mode="$(\builtin command find "${entry}" -prune -printf '%m' \
      2>/dev/null || \builtin true)"
    [[ -n "${actual_mode}" ]] ||
      actual_mode="$(\builtin command stat -f '%Lp' "${entry}" \
        2>/dev/null || \builtin true)"
    actual_mode="${actual_mode#0}"
    actual_size="$(\builtin command wc -c < "${entry}" |
      \builtin command tr -d '[:space:]')" || \builtin return 1
    if \builtin command -v sha256sum >/dev/null 2>&1; then
      actual_sha="$(\builtin command sha256sum -- "${entry}" 2>/dev/null)" ||
        \builtin return 1
    elif \builtin command -v shasum >/dev/null 2>&1; then
      actual_sha="$(\builtin command shasum -a 256 -- "${entry}" 2>/dev/null)" ||
        \builtin return 1
    else
      \builtin printf \
        'CNTools legacy bundle validation requires SHA-256 tooling.\n' >&2
      \builtin return 1
    fi
    actual_sha="${actual_sha%% *}"
    [[ "${actual_mode}" == "${expected_member_mode}" &&
       "${actual_size}" == "${member_sizes[member_index]}" &&
       "${actual_sha}" == "${member_hashes[member_index]}" ]] || {
      \builtin printf 'CNTools legacy bundle member failed integrity validation: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
  done
  while IFS= read -r -d '' entry; do
    [[ -f "${entry}" && ! -L "${entry}" ]] || {
      \builtin printf 'CNTools legacy bundle contains an unsupported entry: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
    member="${entry##*/}"
    known_member="N"
    for candidate in "${members[@]}"; do
      [[ "${candidate}" == "${member}" ]] || continue
      known_member="Y"
      break
    done
    [[ "${known_member}" == "Y" ]] || {
      \builtin printf 'CNTools legacy bundle contains an unknown member: %s\n' \
        "${entry}" >&2
      \builtin return 1
    }
    member_count=$((member_count + 1))
  done < <(\builtin command find "${bundle_dir}" -mindepth 1 -maxdepth 1 -print0)
  (( member_count == 10 )) || \builtin return 1
  canonical_id="$({
    \builtin printf 'cntools-legacy-bundle-v1\n'
    \builtin printf 'facade\tcntools.library\n'
    \builtin printf 'logical-body\t%s\t%s\n' \
      "${logical_body_size}" "${logical_body_sha}"
    for member_index in "${!members[@]}"; do
      \builtin printf 'member\t%s\t0444\t%s\t%s\n' \
        "${members[member_index]}" "${member_sizes[member_index]}" \
        "${member_hashes[member_index]}"
    done
  } | if \builtin command -v sha256sum >/dev/null 2>&1; then
    \builtin command sha256sum
  else
    \builtin command shasum -a 256
  fi)" || \builtin return 1
  canonical_id="${canonical_id%% *}"
  [[ "${canonical_id}" == "${bundle_id}" ]] || \builtin return 1
  [[ "${operation}" == "load" ]] || \builtin return 0

  # Recheck each literal content-addressed path immediately before sourcing.
  # Installed bundles are immutable and replacement requires the same trusted
  # owner; development checkouts retain Git modes but receive identical byte
  # and inventory validation. Alias expansion is suppressed while parsing.
  \builtin shopt -q expand_aliases && aliases_enabled="Y"
  \builtin shopt -u expand_aliases
  for member_index in "${!members[@]}"; do
    member="${members[member_index]}"
    entry="${bundle_dir}/${member}"
    [[ -f "${entry}" && ! -L "${entry}" && -O "${entry}" ]] || {
      [[ "${aliases_enabled}" == "Y" ]] && \builtin shopt -s expand_aliases
      \builtin return 1
    }
    actual_mode="$(\builtin command find "${entry}" -prune -printf '%m' \
      2>/dev/null || \builtin true)"
    [[ -n "${actual_mode}" ]] ||
      actual_mode="$(\builtin command stat -f '%Lp' "${entry}" \
        2>/dev/null || \builtin true)"
    actual_mode="${actual_mode#0}"
    actual_size="$(\builtin command wc -c < "${entry}" |
      \builtin command tr -d '[:space:]')" || actual_size=""
    if \builtin command -v sha256sum >/dev/null 2>&1; then
      actual_sha="$(\builtin command sha256sum -- "${entry}" 2>/dev/null)" ||
        actual_sha=""
    else
      actual_sha="$(\builtin command shasum -a 256 -- "${entry}" 2>/dev/null)" ||
        actual_sha=""
    fi
    actual_sha="${actual_sha%% *}"
    if [[ "${actual_mode}" != "${expected_member_mode}" ||
          "${actual_size}" != "${member_sizes[member_index]}" ||
          "${actual_sha}" != "${member_hashes[member_index]}" ]] ||
       ! \builtin source "${entry}"; then
      [[ "${aliases_enabled}" == "Y" ]] && \builtin shopt -s expand_aliases
      \builtin return 1
    fi
    if (( member_index == 0 )); then
      ESC="$(\builtin printf '\033')"
    fi
  done
  [[ "${aliases_enabled}" == "Y" ]] && \builtin shopt -s expand_aliases

# The exact historical line 411-414 bridge is retained as data for strict
# logical-body reconstruction. Runtime execution above uses alias-safe builtins.
: <<'__CNTOOLS_LEGACY_LOGICAL_INTERSTITIAL__'
# __CNTOOLS_LEGACY_LOGICAL_INTERSTITIAL_BEGIN__
# Command     : selectOption [opt1] [opt2] ...
# Description : Create a bash menu to select one of the provided options
# Parameters  : optX  >  a list of available options to choose from
ESC=$(printf "\033")
# __CNTOOLS_LEGACY_LOGICAL_INTERSTITIAL_END__
__CNTOOLS_LEGACY_LOGICAL_INTERSTITIAL__
}

if ! \__guild_cntools_legacy_bundle_6e40118f preflight; then
  \builtin unset -f __guild_cntools_legacy_bundle_6e40118f
  \builtin return 1
fi

# __CNTOOLS_LEGACY_LOGICAL_INITIALIZATION_BEGIN__
CNTOOLS_MAJOR_VERSION=13
# Minor: Changes and features of minor character that can be applied without breaking existing functionality or workflow
CNTOOLS_MINOR_VERSION=5
# Patch: Backwards compatible bug fixes. No additional functionality or major changes
CNTOOLS_PATCH_VERSION=7

CNTOOLS_VERSION="${CNTOOLS_MAJOR_VERSION}.${CNTOOLS_MINOR_VERSION}.${CNTOOLS_PATCH_VERSION}"
DUMMYFEE=20000

############################################################
# Default config values                                    #
# overriden by values set in cntools.sh                    #
############################################################
TMP_DIR="${TMP_DIR}/cntools"
if ! mkdir -p "${TMP_DIR}" 2>/dev/null; then myExit 1 "${FG_RED}ERROR${NC}: Failed to create directory for temporary files: ${TMP_DIR}"; fi
if ! mkdir -p "${WALLET_FOLDER}" 2>/dev/null; then myExit 1 "${FG_RED}ERROR${NC}: Failed to create wallet directory: ${WALLET_FOLDER}"; fi
if ! mkdir -p "${POOL_FOLDER}" 2>/dev/null; then myExit 1 "${FG_RED}ERROR${NC}: Failed to create pool directory: ${POOL_FOLDER}"; fi
if ! mkdir -p "${ASSET_FOLDER}" 2>/dev/null; then myExit 1 "${FG_RED}ERROR${NC}: Failed to create asset directory: ${ASSET_FOLDER}"; fi
[[ -z ${CNTOOLS_MODE} ]] && CNTOOLS_MODE=LOCAL || CNTOOLS_MODE=${CNTOOLS_MODE^^}
if [[ ${CNTOOLS_MODE} = "LOCAL" ]]; then
  CNTOOLS_MODE_COLOR="${FG_BLUE}"
elif [[ ${CNTOOLS_MODE} = "LIGHT" ]]; then
  CNTOOLS_MODE_COLOR="${FG_GREEN}"
else
  CNTOOLS_MODE_COLOR="${FG_GRAY}"
fi
printf -v launch_modes_info "${FG_BLUE}INFO${NC}: Available launch modes, re-run CNTools in
  ${CNTOOLS_MODE_COLOR}LOCAL${NC} mode (-n): Default mode with a local node connection.
  ${CNTOOLS_MODE_COLOR}LIGHT${NC} mode (-l): Utilizing Koios query layer with full functionallity for supported networks.
  ${CNTOOLS_MODE_COLOR}OFFLINE${NC} mode (-o): A limited set of functionallity without external communication useful for air-gapped mode."
[[ -z ${TIMEOUT_NO_OF_SLOTS} ]] && TIMEOUT_NO_OF_SLOTS=600
[[ -z ${TX_TTL} ]] && TX_TTL=3600
[[ -z ${WALLET_SELECTION_FILTER_LIMIT} ]] && WALLET_SELECTION_FILTER_LIMIT=10
[[ -z ${KES_ALERT_PERIOD} ]] && KES_ALERT_PERIOD=172800 # default 2 days
[[ -z ${KES_WARNING_PERIOD} ]] && KES_WARNING_PERIOD=604800 # default 7 days
[[ $(uname) == Darwin ]] && ENABLE_CHATTR=false
[[ -z ${ENABLE_CHATTR} ]] && ENABLE_CHATTR=true
[[ -z ${ENABLE_DIALOG} ]] && ENABLE_DIALOG=false
[[ ${ENABLE_ADVANCED} = "true" ]] && ADVANCED_MODE="true"
[[ -z ${CHECK_KES} ]] && CHECK_KES=true
[[ -z ${CATALYST_API} ]] && CATALYST_API=https://api.projectcatalyst.io/api/v1
[[ -z ${EXPLORER_TX} ]] && EXPLORER_TX=https://adastat.net/transactions/__tx_id__
[[ -z ${CNTOOLS_LOG} ]] && CNTOOLS_LOG="${LOG_DIR}/cntools-history.log"
[[ -z ${CURRENCY} ]] && CURRENCY="off" || CURRENCY=${CURRENCY,,}
[[ ${CURRENCY} = off || ${NETWORK_NAME} != Mainnet ]] && unset CURRENCY_URL || CURRENCY_URL="https://api.coingecko.com/api/v3/simple/price?ids=cardano&vs_currencies=${CURRENCY}&include_24hr_change=true"

############################################################
# library sourced by cntools with common taskes to perform #
############################################################

# Assumes that env has been sourced by calling script

# __CNTOOLS_LEGACY_LOGICAL_INITIALIZATION_END__

if ! \__guild_cntools_legacy_bundle_6e40118f load; then
  \builtin unset -f __guild_cntools_legacy_bundle_6e40118f
  \builtin return 1
fi
\builtin unset -f __guild_cntools_legacy_bundle_6e40118f
