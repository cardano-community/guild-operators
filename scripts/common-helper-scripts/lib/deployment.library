#!/usr/bin/env bash
# shellcheck shell=bash
# Read and update the deployment metadata shared by Guild helper scripts.

# Keep refresh decisions across repeated env loads in one helper process, but
# never trust state inherited from a parent process or exported environment.
if [[ "${GUILD_PAYLOAD_REFRESH_OWNER_PID:-}" != "$$" ]]; then
  GUILD_PAYLOAD_REFRESH_OWNER_PID="$$"
  GUILD_PAYLOAD_REFRESH_STATE="idle"
  GUILD_PAYLOAD_REFRESH_SIGNATURE=""
  GUILD_PAYLOAD_REFRESH_RESULT=""
fi

deployment_file() {
  printf '%s/.deployment.json\n' "${NODE_HOME:?NODE_HOME is not set}"
}

deployment_get() {
  local key="${1:-}"
  local manifest
  [[ -n "${key}" ]] || return 2
  manifest="$(deployment_file)" || return 2
  [[ -f "${manifest}" && ! -L "${manifest}" && -s "${manifest}" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 2

  jq -er --arg key "${key}" '
    getpath($key | split(".")) as $value
    | select($value != null)
    | if ($value | type) == "string" then $value else ($value | tojson) end
  ' "${manifest}" 2>/dev/null
}

deployment_branch_valid() {
  local branch="${1:-}"
  local component
  local -a components

  [[ "${branch}" =~ ^[A-Za-z0-9_][A-Za-z0-9._/-]*$ &&
     "${branch}" != */ &&
     "${branch}" != *..* &&
     "${branch}" != *//* &&
     "${branch}" != *@\{* &&
     "${branch}" != "@" &&
     "${branch}" != *. ]] || return 1
  IFS='/' read -r -a components <<< "${branch}"
  for component in "${components[@]}"; do
    [[ -n "${component}" &&
       "${component}" != .* &&
       "${component}" != *.lock ]] || return 1
  done
}

deployment_canonical_target_path() {
  local target="${1:-}"
  local canonical="/"
  local candidate
  local component
  local -a components

  [[ "${target}" =~ ^/[A-Za-z0-9._/+@:-]+$ ]] || return 2
  IFS='/' read -r -a components <<< "${target}"
  for component in "${components[@]}"; do
    case "${component}" in
      ""|.)
        continue
        ;;
      ..)
        if [[ "${canonical}" != "/" ]]; then
          canonical="${canonical%/*}"
          [[ -n "${canonical}" ]] || canonical="/"
        fi
        ;;
      *)
        candidate="${canonical%/}/${component}"
        if [[ -L "${candidate}" && ! -e "${candidate}" ]]; then
          return 2
        elif [[ -d "${candidate}" ]]; then
          canonical="$(cd -P -- "${candidate}" 2>/dev/null && pwd -P)" ||
            return 2
        elif [[ -e "${candidate}" ]]; then
          return 2
        else
          canonical="${candidate}"
        fi
        ;;
    esac
  done
  printf '%s' "${canonical}"
}

deployment_target_lock_key() {
  local target_home="${1:-${NODE_HOME:-}}"
  local canonical_target
  canonical_target="$(deployment_canonical_target_path "${target_home}")" ||
    return 2
  printf '%s' "${canonical_target}" | cksum | awk '{printf "%s-%s", $1, $2}'
}

deployment_process_identity() {
  local pid="${1:-}"
  local started="" checksum=""
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 2
  if [[ -r "/proc/${pid}/stat" ]]; then
    started="$(sed 's/^.*) //' "/proc/${pid}/stat" 2>/dev/null |
      awk '{print $20}')"
    [[ "${started}" =~ ^[0-9]+$ ]] || return 1
    printf 'proc-%s' "${started}"
    return 0
  fi
  started="$(LC_ALL=C ps -o lstart= -p "${pid}" 2>/dev/null || true)"
  if [[ -n "${started//[[:space:]]/}" ]]; then
    checksum="$(printf '%s' "${started}" | cksum |
      awk '{printf "%s-%s", $1, $2}')"
    [[ "${checksum}" =~ ^[0-9]+-[0-9]+$ ]] || return 1
    printf 'ps-%s' "${checksum}"
    return 0
  fi
  printf 'pid-only'
}

deployment_directory_lock_is_owned() {
  local lock_path="${1:-}"
  local expected_pid="${2:-${BASHPID:-$$}}"
  local owner_pid="" owner_identity="" current_identity=""
  [[ -d "${lock_path}" && ! -L "${lock_path}" && -O "${lock_path}" &&
     -f "${lock_path}/owner" && ! -L "${lock_path}/owner" &&
     -O "${lock_path}/owner" ]] || return 1
  IFS=$'\t' read -r owner_pid owner_identity < "${lock_path}/owner" || return 1
  [[ "${owner_pid}" == "${expected_pid}" &&
     "${owner_identity}" =~ ^(proc-[0-9]+|ps-[0-9]+-[0-9]+|pid-only)$ ]] ||
    return 1
  current_identity="$(deployment_process_identity "${owner_pid}")" || return 1
  [[ "${current_identity}" == "${owner_identity}" ]]
}

deployment_directory_lock_acquire() {
  local lock_path="${1:-}"
  local owner_pid="" owner_identity="" current_identity="" stale_path=""
  local current_pid="${BASHPID:-$$}"
  [[ -n "${lock_path}" &&
     "${lock_path}" == /tmp/guild-operators-deployment-locks-[0-9]*/*.lock.d ]] ||
    return 2
  while :; do
    if (umask 077 && mkdir -- "${lock_path}") 2>/dev/null; then
      owner_identity="$(deployment_process_identity "${current_pid}")" || {
        rmdir -- "${lock_path}" 2>/dev/null || true
        return 2
      }
      if ! printf '%s\t%s\n' "${current_pid}" "${owner_identity}" > "${lock_path}/owner" ||
         ! chmod 0600 "${lock_path}/owner"; then
        rm -f -- "${lock_path}/owner" 2>/dev/null || true
        rmdir -- "${lock_path}" 2>/dev/null || true
        return 2
      fi
      return 0
    fi
    [[ -d "${lock_path}" && ! -L "${lock_path}" && -O "${lock_path}" &&
       -f "${lock_path}/owner" && ! -L "${lock_path}/owner" &&
       -O "${lock_path}/owner" ]] || return 2
    IFS=$'\t' read -r owner_pid owner_identity < "${lock_path}/owner" || return 2
    [[ "${owner_pid}" =~ ^[0-9]+$ &&
       "${owner_identity}" =~ ^(proc-[0-9]+|ps-[0-9]+-[0-9]+|pid-only)$ ]] ||
      return 2
    current_identity="$(deployment_process_identity "${owner_pid}" 2>/dev/null || true)"
    if kill -0 "${owner_pid}" 2>/dev/null &&
       [[ -n "${current_identity}" && "${current_identity}" == "${owner_identity}" ]]; then
      return 1
    fi
    stale_path="${lock_path}.stale.${current_pid}.$RANDOM"
    if mv -- "${lock_path}" "${stale_path}" 2>/dev/null; then
      rm -f -- "${stale_path}/owner" || return 2
      rmdir -- "${stale_path}" || return 2
      continue
    fi
    return 1
  done
}

deployment_directory_lock_release() {
  local lock_path="${1:-}"
  deployment_directory_lock_is_owned "${lock_path}" "${BASHPID:-$$}" || return 1
  rm -f -- "${lock_path}/owner" 2>/dev/null || return 1
  rmdir -- "${lock_path}" 2>/dev/null
}

deployment_dispatcher_lock_is_owned() {
  local target_home="${1:-${NODE_HOME:-}}"
  local canonical_target
  canonical_target="$(deployment_canonical_target_path "${target_home}")" ||
    return 1
  [[ "${DISPATCHER_LOCK_CANONICAL_TARGET:-}" = "${canonical_target}" &&
     "${DISPATCHER_LOCK_OWNER_PID:-}" = "${BASHPID:-$$}" ]] || return 1

  case "${DISPATCHER_LOCK_KIND:-}" in
    flock)
      [[ -n "${DISPATCHER_LOCK_PATH:-}" &&
         ! -L "${DISPATCHER_LOCK_PATH}" &&
         -f "${DISPATCHER_LOCK_PATH}" &&
         -O "${DISPATCHER_LOCK_PATH}" ]] || return 1
      : 2>/dev/null >&9 || return 1
      flock -n 9 >/dev/null 2>&1 || return 1
      ;;
    directory)
      deployment_directory_lock_is_owned "${DISPATCHER_LOCK_PATH:-}" "${BASHPID:-$$}" ||
        return 1
      ;;
    *)
      return 1
      ;;
  esac
}

deployment_local_lock_is_owned() {
  local canonical_target="${1:-}"
  [[ -n "${canonical_target}" &&
     "${DEPLOYMENT_TARGET_LOCK_CANONICAL_TARGET:-}" = "${canonical_target}" &&
     "${DEPLOYMENT_TARGET_LOCK_OWNER_PID:-}" = "${BASHPID:-$$}" ]] || return 1

  case "${DEPLOYMENT_TARGET_LOCK_METHOD:-}" in
    flock)
      [[ -n "${DEPLOYMENT_TARGET_LOCK_PATH:-}" &&
         ! -L "${DEPLOYMENT_TARGET_LOCK_PATH}" &&
         -f "${DEPLOYMENT_TARGET_LOCK_PATH}" &&
         -O "${DEPLOYMENT_TARGET_LOCK_PATH}" ]] || return 1
      : 2>/dev/null >&8 || return 1
      flock -n 8 >/dev/null 2>&1 || return 1
      ;;
    directory)
      deployment_directory_lock_is_owned "${DEPLOYMENT_TARGET_LOCK_PATH:-}" "${BASHPID:-$$}" ||
        return 1
      ;;
    *)
      return 1
      ;;
  esac
}

deployment_target_lock_acquire() {
  local target_home="${1:-${NODE_HOME:-}}"
  local lock_base
  local lock_key
  local canonical_target
  local lock_backend="${GUILD_DEPLOY_LOCK_BACKEND:-auto}"
  local lock_status=0

  canonical_target="$(deployment_canonical_target_path "${target_home}")" || {
    printf "Cannot lock unsafe deployment path: '%s'\n" "${target_home}" >&2
    return 2
  }
  if [[ "${GUILD_DEPLOY_LOCK_HELD_FOR:-}" = "${canonical_target}" ]] &&
     deployment_dispatcher_lock_is_owned "${target_home}"; then
    DEPLOYMENT_TARGET_LOCK_OWNED="N"
    DEPLOYMENT_TARGET_LOCK_REENTRANT="Y"
    return 0
  fi
  if deployment_local_lock_is_owned "${canonical_target}"; then
    DEPLOYMENT_TARGET_LOCK_DEPTH=$(( ${DEPLOYMENT_TARGET_LOCK_DEPTH:-1} + 1 ))
    DEPLOYMENT_TARGET_LOCK_OWNED="Y"
    DEPLOYMENT_TARGET_LOCK_REENTRANT="N"
    return 0
  fi

  lock_base="/tmp/guild-operators-deployment-locks-$(id -u)"
  if [[ -L "${lock_base}" ]] ||
     { [[ -e "${lock_base}" ]] && [[ ! -d "${lock_base}" || ! -O "${lock_base}" ]]; }; then
    printf "Unsafe deployment lock directory: %s\n" "${lock_base}" >&2
    return 2
  fi
  (umask 077 && mkdir -p "${lock_base}") || return 2
  chmod 0700 "${lock_base}" || return 2
  lock_key="$(deployment_target_lock_key "${canonical_target}")" || return 2

  case "${lock_backend}" in
    auto)
      command -v flock >/dev/null 2>&1 && lock_backend="flock" ||
        lock_backend="directory"
      ;;
    flock) command -v flock >/dev/null 2>&1 || return 2 ;;
    directory) ;;
    *) return 2 ;;
  esac
  if [[ "${lock_backend}" == "flock" ]]; then
    DEPLOYMENT_TARGET_LOCK_PATH="${lock_base}/${lock_key}.lock"
    if [[ -L "${DEPLOYMENT_TARGET_LOCK_PATH}" ]] ||
       { [[ -e "${DEPLOYMENT_TARGET_LOCK_PATH}" ]] && [[ ! -O "${DEPLOYMENT_TARGET_LOCK_PATH}" ]]; }; then
      printf "Unsafe deployment lock file: %s\n" "${DEPLOYMENT_TARGET_LOCK_PATH}" >&2
      return 2
    fi
    (umask 077 && : >> "${DEPLOYMENT_TARGET_LOCK_PATH}") || return 2
    chmod 0600 "${DEPLOYMENT_TARGET_LOCK_PATH}" || return 2
    if ! exec 8>>"${DEPLOYMENT_TARGET_LOCK_PATH}"; then
      return 2
    fi
    if ! flock -n 8; then
      exec 8>&-
      printf "Another deployment or branch/runtime update is active for %s\n" "${target_home}" >&2
      return 1
    fi
    DEPLOYMENT_TARGET_LOCK_METHOD="flock"
  else
    DEPLOYMENT_TARGET_LOCK_PATH="${lock_base}/${lock_key}.lock.d"
    deployment_directory_lock_acquire "${DEPLOYMENT_TARGET_LOCK_PATH}" || {
      lock_status=$?
      if [[ "${lock_status}" -eq 1 ]]; then
        printf "Another deployment or branch/runtime update is active for %s\n" \
          "${target_home}" >&2
      else
        printf "Unsafe or unusable deployment lock: %s\n" \
          "${DEPLOYMENT_TARGET_LOCK_PATH}" >&2
      fi
      return "${lock_status}"
    }
    DEPLOYMENT_TARGET_LOCK_METHOD="directory"
  fi

  DEPLOYMENT_TARGET_LOCK_OWNED="Y"
  DEPLOYMENT_TARGET_LOCK_REENTRANT="N"
  DEPLOYMENT_TARGET_LOCK_DEPTH=1
  DEPLOYMENT_TARGET_LOCK_CANONICAL_TARGET="${canonical_target}"
  DEPLOYMENT_TARGET_LOCK_OWNER_PID="${BASHPID:-$$}"
  GUILD_DEPLOY_LOCK_HELD_FOR="${canonical_target}"
  export GUILD_DEPLOY_LOCK_HELD_FOR
}

deployment_target_lock_release() {
  if [[ "${DEPLOYMENT_TARGET_LOCK_REENTRANT:-N}" = "Y" ]]; then
    DEPLOYMENT_TARGET_LOCK_REENTRANT="N"
    return 0
  fi
  [[ "${DEPLOYMENT_TARGET_LOCK_OWNED:-N}" = "Y" ]] || return 0
  if (( ${DEPLOYMENT_TARGET_LOCK_DEPTH:-1} > 1 )); then
    DEPLOYMENT_TARGET_LOCK_DEPTH=$((DEPLOYMENT_TARGET_LOCK_DEPTH - 1))
    return 0
  fi
  case "${DEPLOYMENT_TARGET_LOCK_METHOD:-}" in
    flock)
      flock -u 8 2>/dev/null || true
      exec 8>&-
      ;;
    directory)
      deployment_directory_lock_release "${DEPLOYMENT_TARGET_LOCK_PATH}" || true
      ;;
  esac
  DEPLOYMENT_TARGET_LOCK_OWNED="N"
  DEPLOYMENT_TARGET_LOCK_REENTRANT="N"
  DEPLOYMENT_TARGET_LOCK_DEPTH=0
  DEPLOYMENT_TARGET_LOCK_METHOD=""
  DEPLOYMENT_TARGET_LOCK_PATH=""
  DEPLOYMENT_TARGET_LOCK_CANONICAL_TARGET=""
  DEPLOYMENT_TARGET_LOCK_OWNER_PID=""
  unset GUILD_DEPLOY_LOCK_HELD_FOR
}

deployment_payload_relative_path_valid() {
  local relative_path="${1:-}"
  local component
  local -a components

  [[ -n "${relative_path}" && "${relative_path}" != /* &&
     "${relative_path}" =~ ^[A-Za-z0-9._/+@:-]+$ ]] || return 1
  IFS='/' read -r -a components <<< "${relative_path}"
  for component in "${components[@]}"; do
    [[ -n "${component}" && "${component}" != "." &&
       "${component}" != ".." ]] || return 1
  done
}

deployment_payload_sha256() {
  local file="${1:-}" sha256_path="" output="" hash=""
  [[ -f "${file}" && ! -L "${file}" ]] || return 1
  sha256_path="$(builtin type -P sha256sum 2>/dev/null)" || return 2
  [[ "${sha256_path}" == /* && -x "${sha256_path}" ]] || return 2
  output="$("${sha256_path}" -- "${file}")" || return 1
  hash="${output%%[[:space:]]*}"
  [[ "${hash}" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "${hash}"
}

deployment_payload_path_mode() {
  local target="${1:-}" mode="" find_path="" stat_path=""

  [[ -e "${target}" && ! -L "${target}" ]] || return 1
  find_path="$(builtin type -P find 2>/dev/null || true)"
  if [[ "${find_path}" == /* && -x "${find_path}" ]]; then
    mode="$("${find_path}" "${target}" -prune -printf '%m' 2>/dev/null || true)"
  fi
  if [[ -z "${mode}" ]]; then
    stat_path="$(builtin type -P stat 2>/dev/null || true)"
    [[ "${stat_path}" == /* && -x "${stat_path}" ]] || return 1
    mode="$("${stat_path}" -f '%Lp' "${target}" 2>/dev/null || true)"
  fi
  case "${mode}" in
    [0-7][0-7][0-7]) printf '0%s\n' "${mode}" ;;
    [0-7][0-7][0-7][0-7]) printf '%s\n' "${mode}" ;;
    *) return 1 ;;
  esac
}

deployment_payload_path_has_no_symlink_components() {
  local target="${1:-}" component="" current=""
  local -a components=()

  [[ "${target}" == /* && "${target}" != "/" ]] || return 1
  IFS='/' read -r -a components <<< "${target}"
  for component in "${components[@]}"; do
    [[ -n "${component}" ]] || continue
    current="${current}/${component}"
    [[ ! -L "${current}" ]] || return 1
    if [[ -e "${current}" && "${current}" != "${target}" ]]; then
      [[ -d "${current}" ]] || return 1
    fi
  done
}

deployment_payload_owned_target_components() {
  local target="${1:-}" relative="" component="" current=""
  local -a components=()

  [[ "${NODE_HOME:-}" == /* && "${target}" == "${NODE_HOME}/"* ]] ||
    return 1
  [[ -d "${NODE_HOME}" && ! -L "${NODE_HOME}" && -O "${NODE_HOME}" ]] ||
    return 1
  relative="${target#"${NODE_HOME}/"}"
  deployment_payload_relative_path_valid "${relative}" || return 1
  current="${NODE_HOME}"
  IFS='/' read -r -a components <<< "${relative}"
  for component in "${components[@]:0:${#components[@]}-1}"; do
    current="${current}/${component}"
    [[ -d "${current}" && ! -L "${current}" && -O "${current}" ]] ||
      return 1
  done
}

deployment_payload_installed_file_authority_valid() {
  local target="${1:-}" expected_mode="${2:-}"
  local actual_mode=""

  deployment_payload_path_has_no_symlink_components "${target}" || return 1
  deployment_payload_owned_target_components "${target}" || return 1
  [[ -f "${target}" && ! -L "${target}" && -O "${target}" &&
     -s "${target}" ]] || return 1
  actual_mode="$(deployment_payload_path_mode "${target}")" || return 1
  [[ "${actual_mode}" == "${expected_mode}" ]]
}

deployment_payload_inventory_emit() {
  local path="${1:-}" source="${2:-}" mode="${3:-}" role="${4:-}"
  printf '%s\t%s\t%s\t%s\n' "${path}" "${source}" "${mode}" "${role}"
}

# The committed receipt is an ordered projection of the frozen source
# manifest. Keep this inventory independent from the installed receipt so a
# count-preserving path substitution cannot authenticate itself.
deployment_payload_expected_inventory() {
  local implementation="${1:-}" network="${2:-}" order_class="${3:-}"

  case "${implementation}:${network}:${order_class}" in
    cnode:mainnet:legacy|cnode:guild:legacy|cnode:preprod:legacy|\
    cnode:preview:legacy|dingo:preprod:legacy|dingo:preview:legacy|\
    amaru:preprod:legacy|amaru:preview:legacy|\
    cnode:mainnet:reader-isolated|cnode:guild:reader-isolated|\
    cnode:preprod:reader-isolated|cnode:preview:reader-isolated|\
    dingo:preprod:reader-isolated|dingo:preview:reader-isolated) ;;
    *) return 1 ;;
  esac

  if [[ "${order_class}" == "reader-isolated" ]]; then
    deployment_payload_inventory_emit \
      scripts/cntools.library scripts/common-helper-scripts/cntools.library \
      0644 merge
  fi
  deployment_payload_inventory_emit \
    scripts/guild-deploy.sh scripts/cnode-helper-scripts/guild-deploy.sh \
    0755 merge
  deployment_payload_inventory_emit \
    scripts/lib/deployment.library \
    scripts/common-helper-scripts/lib/deployment.library 0644 exact
  deployment_payload_inventory_emit \
    scripts/lib/env.library scripts/common-helper-scripts/lib/env.library \
    0644 exact
  deployment_payload_inventory_emit \
    scripts/lib/node-api.library \
    scripts/common-helper-scripts/lib/node-api.library 0644 exact
  deployment_payload_inventory_emit \
    scripts/lib/systemd.library \
    scripts/common-helper-scripts/lib/systemd.library 0644 exact
  deployment_payload_inventory_emit \
    "scripts/adapters/${implementation}.adapter" \
    "scripts/${implementation}-helper-scripts/${implementation}.adapter" \
    0644 exact
  deployment_payload_inventory_emit \
    scripts/env scripts/common-helper-scripts/env 0644 merge

  case "${implementation}" in
    cnode)
      deployment_payload_inventory_emit scripts/blockPerf.sh \
        scripts/cnode-helper-scripts/blockPerf.sh 0755 merge
      deployment_payload_inventory_emit scripts/cabal-build-all.sh \
        scripts/cnode-helper-scripts/cabal-build-all.sh 0755 merge
      deployment_payload_inventory_emit scripts/cncli.sh \
        scripts/cnode-helper-scripts/cncli.sh 0755 merge
      deployment_payload_inventory_emit scripts/cnode.sh \
        scripts/cnode-helper-scripts/cnode.sh 0755 merge
      deployment_payload_inventory_emit scripts/cntools.sh \
        scripts/common-helper-scripts/cntools.sh 0755 merge
      if [[ "${order_class}" == "legacy" ]]; then
        deployment_payload_inventory_emit scripts/cntools.library \
          scripts/common-helper-scripts/cntools.library 0644 merge
      fi
      deployment_payload_inventory_emit scripts/dbsync.sh \
        scripts/cnode-helper-scripts/dbsync.sh 0755 merge
      deployment_payload_inventory_emit scripts/gLiveView.sh \
        scripts/common-helper-scripts/gLiveView.sh 0755 merge
      deployment_payload_inventory_emit scripts/topologyUpdater.sh \
        scripts/cnode-helper-scripts/topologyUpdater.sh 0755 merge
      deployment_payload_inventory_emit scripts/logMonitor.sh \
        scripts/cnode-helper-scripts/logMonitor.sh 0755 merge
      deployment_payload_inventory_emit scripts/ogmios.sh \
        scripts/cnode-helper-scripts/ogmios.sh 0755 merge
      deployment_payload_inventory_emit scripts/submitapi.sh \
        scripts/cnode-helper-scripts/submitapi.sh 0755 merge
      deployment_payload_inventory_emit scripts/setup_mon.sh \
        scripts/cnode-helper-scripts/setup_mon.sh 0755 merge
      deployment_payload_inventory_emit scripts/setup-grest.sh \
        scripts/grest-helper-scripts/setup-grest.sh 0755 merge
      deployment_payload_inventory_emit scripts/grest-poll.sh \
        scripts/grest-helper-scripts/grest-poll.sh 0755 merge
      deployment_payload_inventory_emit scripts/checkstatus.sh \
        scripts/grest-helper-scripts/checkstatus.sh 0755 merge
      deployment_payload_inventory_emit scripts/getmetrics.sh \
        scripts/grest-helper-scripts/getmetrics.sh 0755 merge
      deployment_payload_inventory_emit scripts/mithril-client.sh \
        scripts/cnode-helper-scripts/mithril-client.sh 0755 merge
      deployment_payload_inventory_emit scripts/mithril-relay.sh \
        scripts/cnode-helper-scripts/mithril-relay.sh 0755 merge
      deployment_payload_inventory_emit scripts/mithril-signer.sh \
        scripts/cnode-helper-scripts/mithril-signer.sh 0755 merge
      deployment_payload_inventory_emit scripts/mithril.library \
        scripts/cnode-helper-scripts/mithril.library 0644 merge
      deployment_payload_inventory_emit files/cnode-release.json \
        files/node-implementations/cnode/release.json 0644 exact
      deployment_payload_inventory_emit files/cntools-changelog.md \
        files/node-implementations/cnode/cntools-changelog.md 0644 exact
      deployment_payload_inventory_emit files/alonzo-genesis.json \
        "files/configs/cnode/${network}/alonzo-genesis.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/byron-genesis.json \
        "files/configs/cnode/${network}/byron-genesis.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/conway-genesis.json \
        "files/configs/cnode/${network}/conway-genesis.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/shelley-genesis.json \
        "files/configs/cnode/${network}/shelley-genesis.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/topology.json \
        "files/configs/cnode/${network}/topology.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/config.json \
        "files/configs/cnode/${network}/config.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/dbsync.json \
        "files/configs/cnode/${network}/db-sync-config.json" 0644 preserve-cnode
      deployment_payload_inventory_emit files/submitapi.json \
        "files/configs/cnode/${network}/submitapi.json" 0644 exact
      ;;
    dingo)
      deployment_payload_inventory_emit scripts/dingo.sh \
        scripts/dingo-helper-scripts/dingo.sh 0755 exact
      deployment_payload_inventory_emit scripts/gLiveView.sh \
        scripts/common-helper-scripts/gLiveView.sh 0755 merge
      if [[ "${order_class}" == "legacy" ]]; then
        deployment_payload_inventory_emit scripts/cntools.library \
          scripts/common-helper-scripts/cntools.library 0644 merge
      fi
      deployment_payload_inventory_emit scripts/cntools.sh \
        scripts/common-helper-scripts/cntools.sh 0755 merge
      deployment_payload_inventory_emit files/dingo.yaml \
        "files/configs/dingo/${network}/dingo.yaml" 0640 preserve-dingo
      deployment_payload_inventory_emit scripts/dingo.env \
        "files/configs/dingo/${network}/dingo.env" 0640 preserve-dingo
      deployment_payload_inventory_emit files/dingo-release.json \
        files/node-implementations/dingo/release.json 0644 exact
      deployment_payload_inventory_emit files/cntools-changelog.md \
        files/node-implementations/cnode/cntools-changelog.md 0644 exact
      ;;
    amaru)
      deployment_payload_inventory_emit scripts/amaru.sh \
        scripts/amaru-helper-scripts/amaru.sh 0755 exact
      deployment_payload_inventory_emit scripts/gLiveView.sh \
        scripts/common-helper-scripts/gLiveView.sh 0755 merge
      deployment_payload_inventory_emit scripts/amaru.env \
        "files/configs/amaru/${network}/amaru.env" 0640 preserve-amaru
      deployment_payload_inventory_emit files/otelcol.yaml \
        files/configs/amaru/otelcol.yaml 0644 exact
      deployment_payload_inventory_emit files/amaru-release.json \
        files/node-implementations/amaru/release.json 0644 exact
      ;;
  esac
}

deployment_payload_inventory_valid() {
  local receipt="${1:-}" schema="${2:-}" implementation="${3:-}"
  local network="${4:-}" file_count="${5:-}"
  local generation_manifest="${6:-}" work_root="${7:-}"
  local jq_path="${8:-}"
  local expected="${work_root}/expected-inventory.tsv"
  local actual="${work_root}/actual-inventory.tsv"
  local include_bundle=N bundle_id="" order_class="legacy"
  local expected_path="" expected_source="" expected_mode="" role=""
  local expected_hash="" actual_path="" actual_source="" actual_mode=""
  local policy="" managed="" source_hash="" installed_hash=""
  local expected_status=0 actual_status=0 visited=0

  [[ -f "${receipt}" && ! -L "${receipt}" && -d "${work_root}" &&
     -x "${jq_path}" ]] || return 1
  if [[ "${schema}" == "2" &&
        ( "${implementation}" == "cnode" ||
          "${implementation}" == "dingo" ) ]]; then
    case "${file_count}" in
      20) ;;
      30|152)
        include_bundle=Y
        order_class=reader-isolated
        ;;
      *) return 1 ;;
    esac
  elif [[ "${schema}" != "1" &&
          "${schema}:${implementation}" != "2:amaru" ]]; then
    return 1
  fi

  printf '' > "${expected}" || return 1
  if [[ "${include_bundle}" == "Y" ]]; then
    [[ -f "${generation_manifest}" && ! -L "${generation_manifest}" ]] ||
      return 1
    "${jq_path}" -e '
      .legacyBundle as $bundle |
      ($bundle | type == "object") and
      ($bundle | keys == ["facade", "id", "idAlgorithm",
        "logicalBodySha256", "logicalBodySize", "members", "path",
        "schemaVersion"]) and
      $bundle.schemaVersion == 1 and
      $bundle.idAlgorithm == "sha256-cntools-legacy-bundle-v1" and
      ($bundle.id | type == "string" and test("^[0-9a-f]{64}$")) and
      $bundle.path == ("cntools/libs/legacy/" + $bundle.id) and
      $bundle.facade == "cntools.library" and
      ($bundle.logicalBodySha256 | type == "string" and
        test("^[0-9a-f]{64}$")) and
      ($bundle.logicalBodySize | type == "number" and . > 0 and
        . == floor) and
      ($bundle.members | type == "array" and length == 10) and
      ($bundle.members | map(.path)) == [
        "010-common-dialog.sh",
        "020-terminal-selection-security.sh",
        "030-governance-query.sh",
        "040-address-wallet-query.sh",
        "050-wallet-create-registration.sh",
        "060-wallet-actions.sh",
        "070-pool-actions.sh",
        "080-metadata-assets.sh",
        "090-governance-actions.sh",
        "100-transaction-hardware-price.sh"
      ] and
      all($bundle.members[];
        type == "object" and
        keys == ["mode", "path", "sha256", "size"] and
        .mode == "0444" and
        (.sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
        (.size | type == "number" and . > 0 and . == floor))
    ' "${generation_manifest}" >/dev/null 2>&1 || return 1
    bundle_id="$("${jq_path}" -er '.legacyBundle.id' \
      "${generation_manifest}")" || return 1
    "${jq_path}" -er --arg id "${bundle_id}" '
      .legacyBundle.members[] |
      ["scripts/cntools/libs/legacy/" + $id + "/" + .path,
       "scripts/common-helper-scripts/cntools/libs/legacy/" + $id + "/" + .path,
       .mode, "bundle", .sha256] | @tsv
    ' "${generation_manifest}" > "${expected}" || return 1
  fi
  deployment_payload_expected_inventory \
    "${implementation}" "${network}" "${order_class}" >> "${expected}" ||
    return 1
  "${jq_path}" -er '
    .files[] |
    [.path, .source, .mode, .policy, (.managed | tostring),
      .sourceSha256, .installedSha256] | @tsv
  ' "${receipt}" > "${actual}" || return 1

  exec 7< "${expected}" 8< "${actual}" || return 1
  while builtin true; do
    IFS=$'\t' read -r expected_path expected_source expected_mode role \
      expected_hash <&7
    expected_status=$?
    IFS=$'\t' read -r actual_path actual_source actual_mode policy managed \
      source_hash installed_hash <&8
    actual_status=$?
    if [[ ${expected_status} -ne 0 || ${actual_status} -ne 0 ]]; then
      [[ ${expected_status} -ne 0 && ${actual_status} -ne 0 ]] || {
        exec 7<&- 8<&-
        return 1
      }
      break
    fi
    [[ "${actual_path}" == "${expected_path}" &&
       "${actual_source}" == "${expected_source}" ]] || {
      exec 7<&- 8<&-
      return 1
    }
    case "${role}" in
      bundle)
        [[ "${actual_mode}" == "${expected_mode}" &&
           "${policy}" == "cntools-legacy-bundle" &&
           "${managed}" == "true" &&
           "${source_hash}" == "${expected_hash}" &&
           "${installed_hash}" == "${expected_hash}" ]] || {
          exec 7<&- 8<&-
          return 1
        }
        ;;
      exact)
        [[ "${actual_mode}" == "${expected_mode}" &&
           "${policy}" == "exact" && "${managed}" == "true" &&
           "${installed_hash}" == "${source_hash}" ]] || {
          exec 7<&- 8<&-
          return 1
        }
        ;;
      merge)
        [[ "${actual_mode}" == "${expected_mode}" &&
           "${policy}" == "merge-header" && "${managed}" == "true" ]] || {
          exec 7<&- 8<&-
          return 1
        }
        ;;
      preserve-cnode|preserve-dingo|preserve-amaru)
        [[ "${managed}" == "false" &&
           ( ( "${policy}" == "render-${implementation}" &&
               "${actual_mode}" == "${expected_mode}" ) ||
             ( "${policy}" == "operator-preserved" &&
               "${actual_mode}" =~ ^0[4-7][0145][0145]$ ) ) ]] || {
          exec 7<&- 8<&-
          return 1
        }
        ;;
      *)
        exec 7<&- 8<&-
        return 1
        ;;
    esac
    visited=$((visited + 1))
  done
  exec 7<&- 8<&-
  case "${implementation}" in
    cnode)
      if [[ "${include_bundle}" == "Y" ]]; then
        [[ ${visited} -eq 48 ]]
      else
        [[ ${visited} -eq 38 ]]
      fi
      ;;
    dingo)
      if [[ "${include_bundle}" == "Y" ]]; then
        [[ ${visited} -eq 25 ]]
      else
        [[ ${visited} -eq 15 ]]
      fi
      ;;
    amaru) [[ ${visited} -eq 12 ]] ;;
    *) return 1 ;;
  esac
}

deployment_payload_generation_tree_authority_valid() {
  local generation="${1:-}" work_root="${2:-}" find_path="${3:-}"
  local state_root="${NODE_HOME}/scripts/.cntools"
  local generations_root="${state_root}/generations"
  local directories="${work_root}/generation-directories.list"
  local symlinks="${work_root}/generation-symlinks.list"
  local directory="" directory_count=0

  [[ "${find_path}" == /* && -x "${find_path}" &&
     "${generation}" == "${generations_root}/"* &&
     -d "${state_root}" && ! -L "${state_root}" && -O "${state_root}" &&
     -d "${generations_root}" && ! -L "${generations_root}" &&
     -O "${generations_root}" &&
     -d "${generation}" && ! -L "${generation}" && -O "${generation}" ]] ||
    return 1
  deployment_payload_path_has_no_symlink_components "${generation}" || return 1
  [[ "$(deployment_payload_path_mode "${state_root}")" == "0700" &&
     "$(deployment_payload_path_mode "${generations_root}")" == "0700" &&
     "$(deployment_payload_path_mode "${generation}")" == "0555" ]] ||
    return 1
  "${find_path}" "${generation}" -type l -print0 > "${symlinks}" || return 1
  [[ ! -s "${symlinks}" ]] || return 1
  "${find_path}" "${generation}" -type d -print0 > "${directories}" || return 1
  while IFS= read -r -d '' directory; do
    [[ "${directory}" == "${generation}" ||
       "${directory}" == "${generation}/"* ]] || return 1
    [[ -d "${directory}" && ! -L "${directory}" && -O "${directory}" &&
       "$(deployment_payload_path_mode "${directory}")" == "0555" ]] ||
      return 1
    directory_count=$((directory_count + 1))
  done < "${directories}"
  [[ ${directory_count} -gt 0 ]]
}

# Verify the committed authority and its exact installed payload inventory.
# Preserve rows remain operator-editable, but they must still exist as safe,
# owner-controlled physical files at the mode recorded by the receipt.
deployment_payload_is_current() (
  local manifest="" receipt="" journal="${NODE_HOME}/.guild-deploy-transaction"
  local snapshot_root="" snapshot_manifest="" snapshot_receipt=""
  local snapshot_manifest_hash="" snapshot_receipt_hash=""
  local expected_receipt_hash="" transaction_id="" receipt_schema=""
  local source_schema="" implementation="" network="" generation_id=""
  local generation_path="" generation="" generation_manifest=""
  local generation_receipt="" generation_lifecycle=""
  local snapshot_generation_manifest="" snapshot_generation_receipt=""
  local expected_manifest_hash="" expected_generation_receipt_hash=""
  local file_count="" expected_lifecycle_hash="" lifecycle_record=""
  local relative_path="" source_path="" expected_mode="" policy=""
  local managed="" source_hash="" expected_hash="" target=""
  local actual_hash="" declared_count=0 visited_count=0
  local jq_path="" find_path="" mktemp_path="" cp_path="" rm_path=""
  local rmdir_path=""

  [[ ! -e "${journal}" && ! -L "${journal}" ]] || return 1
  manifest="$(deployment_file)" || return 1
  receipt="${NODE_HOME}/.guild-source-receipt.json"
  [[ "${manifest}" == "${NODE_HOME}/.deployment.json" ]] || return 1
  deployment_payload_installed_file_authority_valid "${manifest}" 0644 ||
    return 1
  deployment_payload_installed_file_authority_valid "${receipt}" 0644 ||
    return 1

  jq_path="$(builtin type -P jq 2>/dev/null)" || return 1
  find_path="$(builtin type -P find 2>/dev/null)" || return 1
  mktemp_path="$(builtin type -P mktemp 2>/dev/null)" || return 1
  cp_path="$(builtin type -P cp 2>/dev/null)" || return 1
  rm_path="$(builtin type -P rm 2>/dev/null)" || return 1
  rmdir_path="$(builtin type -P rmdir 2>/dev/null)" || return 1
  [[ "${jq_path}" == /* && -x "${jq_path}" &&
     "${find_path}" == /* && -x "${find_path}" &&
     "${mktemp_path}" == /* && -x "${mktemp_path}" &&
     "${cp_path}" == /* && -x "${cp_path}" &&
     "${rm_path}" == /* && -x "${rm_path}" &&
     "${rmdir_path}" == /* && -x "${rmdir_path}" ]] || return 1

  snapshot_root="$("${mktemp_path}" -d \
    "${TMPDIR:-/tmp}/guild-payload-current.XXXXXXXX")" || return 1
  snapshot_manifest="${snapshot_root}/deployment.json"
  snapshot_receipt="${snapshot_root}/receipt.json"
  snapshot_generation_manifest="${snapshot_root}/generation-manifest.json"
  snapshot_generation_receipt="${snapshot_root}/generation-receipt.json"
  trap '"${rm_path}" -f "${snapshot_manifest}" "${snapshot_receipt}" \
    "${snapshot_generation_manifest}" "${snapshot_generation_receipt}" \
    "${snapshot_root}/expected-inventory.tsv" \
    "${snapshot_root}/actual-inventory.tsv" \
    "${snapshot_root}/generation-directories.list" \
    "${snapshot_root}/generation-symlinks.list" 2>/dev/null || builtin true; \
    "${rmdir_path}" "${snapshot_root}" 2>/dev/null || builtin true' EXIT
  [[ -d "${snapshot_root}" && ! -L "${snapshot_root}" &&
     -O "${snapshot_root}" &&
     "$(deployment_payload_path_mode "${snapshot_root}")" == "0700" ]] ||
    return 1
  "${cp_path}" -- "${manifest}" "${snapshot_manifest}" || return 1
  "${cp_path}" -- "${receipt}" "${snapshot_receipt}" || return 1
  snapshot_manifest_hash="$(deployment_payload_sha256 \
    "${snapshot_manifest}")" || return 1
  snapshot_receipt_hash="$(deployment_payload_sha256 \
    "${snapshot_receipt}")" || return 1
  [[ "$(deployment_payload_sha256 "${manifest}")" == \
       "${snapshot_manifest_hash}" &&
     "$(deployment_payload_sha256 "${receipt}")" == \
       "${snapshot_receipt_hash}" ]] || return 1

  "${jq_path}" -e '
    . as $receipt |
    type == "object" and
    (
      if .schemaVersion == 1 then
        keys == ["files", "implementation", "network", "schemaVersion",
          "source"] and (has("cntoolsGeneration") | not)
      elif .schemaVersion == 2 and
           (.implementation == "cnode" or .implementation == "dingo") then
        keys == ["cntoolsGeneration", "files", "implementation", "network",
          "schemaVersion", "source"]
      elif .schemaVersion == 2 and .implementation == "amaru" then
        keys == ["files", "implementation", "network", "schemaVersion",
          "source"] and (has("cntoolsGeneration") | not)
      else false end
    ) and
    ((.implementation == "cnode" and
       (.network == "mainnet" or .network == "guild" or
        .network == "preprod" or .network == "preview")) or
     ((.implementation == "dingo" or .implementation == "amaru") and
       (.network == "preprod" or .network == "preview"))) and
    (.source as $source |
      ($source | type == "object") and
      (($source.dirty == false and
        ($source | keys == ["channel", "dirty", "mode", "ref",
          "repository", "revision"])) or
       ($source.dirty == true and $source.mode == "local" and
        ($source | keys == ["channel", "dirty", "mode", "ref",
          "repository", "revision", "treeDigest"]) and
        ($source.treeDigest | type == "string" and
          test("^[0-9a-f]{64}$")))) and
      ($source.repository | type == "string" and
        test("^[A-Za-z0-9_.-]+/guild-operators$")) and
      ($source.channel | type == "string" and length > 0) and
      ($source.ref | type == "string" and test("^refs/(heads|tags)/")) and
      ($source.revision | type == "string" and
        test("^[0-9a-f]{40,64}$")) and
      ($source.mode == "managed" or $source.mode == "cached" or
        $source.mode == "local") and
      ($source.dirty | type == "boolean")) and
    (.files | type == "array" and length > 0) and
    ([.files[].path] | length == (unique | length)) and
    all(.files[];
      type == "object" and
      keys == ["installedSha256", "managed", "mode", "path", "policy",
        "source", "sourceSha256"] and
      (.path | type == "string" and
        test("^(scripts|files)/[A-Za-z0-9._/+@:-]+$") and
        (contains("//") | not) and
        (split("/") | all(. != "" and . != "." and . != ".."))) and
      (.source | type == "string" and
        test("^(scripts|files)/[A-Za-z0-9._/+@:-]+$") and
        (contains("//") | not) and
        (split("/") | all(. != "" and . != "." and . != ".."))) and
      (.mode | type == "string" and test("^0[0-7]{3}$")) and
      (.policy == "exact" or .policy == "merge-header" or
        .policy == "render-cnode" or .policy == "render-dingo" or
        .policy == "render-amaru" or .policy == "operator-preserved" or
        .policy == "cntools-legacy-bundle") and
      (.sourceSha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.installedSha256 | type == "string" and
        test("^[0-9a-f]{64}$")) and
      (.managed | type == "boolean")) and
    (
      if .schemaVersion == 1 then
        (if .implementation == "cnode" then (.files | length == 38)
         elif .implementation == "dingo" then (.files | length == 15)
         else (.files | length == 12) end)
      elif .implementation == "amaru" then
        (.files | length == 12)
      else
        (.cntoolsGeneration as $generation |
          ($generation | type == "object") and
          ($generation | keys == ["active", "fileCount",
            "generationReceipt", "generationReceiptSha256", "id", "path",
            "payloadManifest", "payloadManifestSha256", "schemaVersion",
            "version"]) and
          $generation.schemaVersion == 1 and $generation.active == false and
          ($generation.fileCount == 20 or $generation.fileCount == 30 or
            $generation.fileCount == 152) and
          ($generation.id | type == "string" and
            test("^[0-9a-f]{64}$")) and
          ($generation.version | type == "string" and length > 0) and
          $generation.path ==
            ("scripts/.cntools/generations/" + $generation.id) and
          $generation.payloadManifest ==
            ($generation.path + "/cntools/manifest.json") and
          $generation.generationReceipt ==
            ($generation.path + "/.generation.json") and
          ($generation.payloadManifestSha256 | type == "string" and
            test("^[0-9a-f]{64}$")) and
          ($generation.generationReceiptSha256 | type == "string" and
            test("^[0-9a-f]{64}$")) and
          (($receipt.files | length) ==
            (if $receipt.implementation == "cnode" then
               (if $generation.fileCount == 20 then 38 else 48 end)
             else
               (if $generation.fileCount == 20 then 15 else 25 end)
             end)))
      end
    )
  ' "${snapshot_receipt}" >/dev/null 2>&1 || return 1

  receipt_schema="$("${jq_path}" -er '.schemaVersion' \
    "${snapshot_receipt}")" || return 1
  implementation="$("${jq_path}" -er '.implementation' \
    "${snapshot_receipt}")" || return 1
  network="$("${jq_path}" -er '.network' "${snapshot_receipt}")" || return 1
  "${jq_path}" -e --arg receipt_hash "${snapshot_receipt_hash}" \
    --argjson receipt_schema "${receipt_schema}" '
    type == "object" and
    ((.sourceDirty == false and
      keys == ["branch", "capabilities", "deploymentStatus",
        "implementation", "metricsProvider", "network", "nodePort",
        "nodeVersion", "payloadReceipt", "payloadReceiptSha256",
        "repository", "schemaVersion", "serviceName", "sourceDirty",
        "sourceMode", "sourceRef", "sourceRevision", "sourceSchemaVersion",
        "targetNodeVersion", "transactionId"]) or
     (.sourceDirty == true and
      keys == ["branch", "capabilities", "deploymentStatus",
        "implementation", "metricsProvider", "network", "nodePort",
        "nodeVersion", "payloadReceipt", "payloadReceiptSha256",
        "repository", "schemaVersion", "serviceName", "sourceDirty",
        "sourceMode", "sourceRef", "sourceRevision", "sourceSchemaVersion",
        "sourceTreeDigest", "targetNodeVersion", "transactionId"] and
      .sourceMode == "local" and
      (.sourceTreeDigest | type == "string" and
        test("^[0-9a-f]{64}$")))) and
    .schemaVersion == 1 and .deploymentStatus == "deployed" and
    (.implementation == "cnode" or .implementation == "dingo" or
      .implementation == "amaru") and
    (.network | type == "string" and length > 0) and
    (.branch | type == "string" and length > 0) and
    (.repository | type == "string" and
      test("^[A-Za-z0-9_.-]+/guild-operators$")) and
    (.serviceName | type == "string" and length > 0) and
    (.nodePort | type == "number" and . >= 1 and . <= 65535 and
      . == floor) and
    (.nodeVersion | type == "string") and
    (.targetNodeVersion | type == "string") and
    (.metricsProvider | type == "string" and length > 0) and
    (.capabilities as $capabilities |
      ($capabilities | type == "object") and
      ($capabilities | keys == ["forging", "localCli", "metrics", "n2c"]) and
      all($capabilities[]; type == "boolean")) and
    (.sourceSchemaVersion == 1 or .sourceSchemaVersion == 2) and
    (.sourceMode == "managed" or .sourceMode == "cached" or
      .sourceMode == "local") and
    (.sourceRef | type == "string" and test("^refs/(heads|tags)/")) and
    (.sourceRevision | type == "string" and test("^[0-9a-f]{40,64}$")) and
    (.sourceDirty | type == "boolean") and
    .payloadReceipt == ".guild-source-receipt.json" and
    .payloadReceiptSha256 == $receipt_hash and
    (if $receipt_schema == 1 then
       (.transactionId | type == "string" and
         (test("^[0-9a-f]{16}$") or test("^[0-9a-f]{24}$")))
     else
       (.transactionId | type == "string" and test("^[0-9a-f]{24}$"))
     end)
  ' "${snapshot_manifest}" >/dev/null 2>&1 || return 1

  expected_receipt_hash="$("${jq_path}" -er '.payloadReceiptSha256' \
    "${snapshot_manifest}")" || return 1
  [[ "${expected_receipt_hash}" == "${snapshot_receipt_hash}" ]] || return 1
  transaction_id="$("${jq_path}" -er '.transactionId' \
    "${snapshot_manifest}")" || return 1
  [[ "${transaction_id}" == \
       "${snapshot_receipt_hash:0:${#transaction_id}}" ]] || return 1
  "${jq_path}" -e -s '
    .[0] as $receipt | .[1] as $metadata |
    $metadata.implementation == $receipt.implementation and
    $metadata.network == $receipt.network and
    $metadata.repository == $receipt.source.repository and
    $metadata.branch == $receipt.source.channel and
    $metadata.sourceSchemaVersion == $receipt.schemaVersion and
    $metadata.sourceMode == $receipt.source.mode and
    $metadata.sourceRef == $receipt.source.ref and
    $metadata.sourceRevision == $receipt.source.revision and
    $metadata.sourceDirty == $receipt.source.dirty and
    (if $receipt.source.dirty then
       $metadata.sourceTreeDigest == $receipt.source.treeDigest
     else
       ($metadata | has("sourceTreeDigest") | not) and
       ($receipt.source | has("treeDigest") | not)
     end)
  ' "${snapshot_receipt}" "${snapshot_manifest}" >/dev/null 2>&1 || return 1

  source_schema="${receipt_schema}"
  if [[ "${source_schema}" == "2" &&
        ( "${implementation}" == "cnode" ||
          "${implementation}" == "dingo" ) ]]; then
    generation_id="$("${jq_path}" -er '.cntoolsGeneration.id' \
      "${snapshot_receipt}")" || return 1
    generation_path="$("${jq_path}" -er '.cntoolsGeneration.path' \
      "${snapshot_receipt}")" || return 1
    expected_manifest_hash="$("${jq_path}" -er \
      '.cntoolsGeneration.payloadManifestSha256' \
      "${snapshot_receipt}")" || return 1
    expected_generation_receipt_hash="$("${jq_path}" -er \
      '.cntoolsGeneration.generationReceiptSha256' \
      "${snapshot_receipt}")" || return 1
    file_count="$("${jq_path}" -er '.cntoolsGeneration.fileCount' \
      "${snapshot_receipt}")" || return 1
    [[ "${generation_path}" == \
         "scripts/.cntools/generations/${generation_id}" &&
       "${generation_id}" =~ ^[0-9a-f]{64}$ ]] || return 1
    generation="${NODE_HOME}/${generation_path}"
    generation_manifest="${generation}/cntools/manifest.json"
    generation_receipt="${generation}/.generation.json"
    generation_lifecycle="${generation}/cntools/core/lifecycle.sh"
    deployment_payload_generation_tree_authority_valid \
      "${generation}" "${snapshot_root}" "${find_path}" || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_manifest}" 0444 || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_receipt}" 0444 || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_lifecycle}" 0444 || return 1
    "${cp_path}" -- "${generation_manifest}" \
      "${snapshot_generation_manifest}" || return 1
    "${cp_path}" -- "${generation_receipt}" \
      "${snapshot_generation_receipt}" || return 1
    [[ "$(deployment_payload_sha256 "${snapshot_generation_manifest}")" == \
         "${expected_manifest_hash}" &&
       "$(deployment_payload_sha256 "${snapshot_generation_receipt}")" == \
         "${expected_generation_receipt_hash}" &&
       "$(deployment_payload_sha256 "${generation_manifest}")" == \
         "${expected_manifest_hash}" &&
       "$(deployment_payload_sha256 "${generation_receipt}")" == \
         "${expected_generation_receipt_hash}" ]] || return 1
    "${jq_path}" -e -s '
      .[0].cntoolsGeneration as $outer |
      $outer.version == .[1].version and $outer.version == .[2].version and
      (if $outer.fileCount == 20 then
         .[1].schemaVersion == 1 and (.[1].files | length == 19) and
         .[2].schemaVersion == 1 and (.[2].files | length == 20)
       elif $outer.fileCount == 30 then
         .[1].schemaVersion == 2 and (.[1].files | length == 29) and
         .[2].schemaVersion == 2 and (.[2].files | length == 30)
       elif $outer.fileCount == 152 then
         .[1].schemaVersion == 3 and (.[1].files | length == 151) and
         .[2].schemaVersion == 3 and (.[2].files | length == 152)
       else false end)
    ' "${snapshot_receipt}" "${snapshot_generation_manifest}" \
      "${snapshot_generation_receipt}" >/dev/null 2>&1 || return 1
    lifecycle_record="$("${jq_path}" -er '
      [.files[] | select(.path == "cntools/core/lifecycle.sh")] |
      if length == 1 and
         .[0].source ==
           "scripts/common-helper-scripts/cntools/core/lifecycle.sh" and
         .[0].mode == "0444" and .[0].validator == "shell" and
         (.[0].sha256 | type == "string" and test("^[0-9a-f]{64}$"))
      then .[0].sha256 else error("invalid lifecycle record") end
    ' "${snapshot_generation_receipt}")" || return 1
    expected_lifecycle_hash="${lifecycle_record}"
    [[ "$(deployment_payload_sha256 "${generation_lifecycle}")" == \
         "${expected_lifecycle_hash}" ]] || return 1
    deployment_payload_inventory_valid "${snapshot_receipt}" \
      "${source_schema}" "${implementation}" "${network}" "${file_count}" \
      "${snapshot_generation_manifest}" "${snapshot_root}" "${jq_path}" ||
      return 1
    # Recheck the exact authenticated source immediately before evaluation.
    deployment_payload_generation_tree_authority_valid \
      "${generation}" "${snapshot_root}" "${find_path}" || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_manifest}" 0444 || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_receipt}" 0444 || return 1
    deployment_payload_installed_file_authority_valid \
      "${generation_lifecycle}" 0444 || return 1
    [[ "$(deployment_payload_sha256 "${generation_manifest}")" == \
         "${expected_manifest_hash}" &&
       "$(deployment_payload_sha256 "${generation_receipt}")" == \
         "${expected_generation_receipt_hash}" &&
       "$(deployment_payload_sha256 "${generation_lifecycle}")" == \
         "${expected_lifecycle_hash}" ]] || return 1
    # shellcheck source=/dev/null
    builtin source "${generation_lifecycle}" || return 1
    cntools_generation_validate "${generation}" "${generation_id}" || return 1
    cntools_generation_pointers_validate \
      "${NODE_HOME}/scripts/.cntools" || return 1
  else
    deployment_payload_inventory_valid "${snapshot_receipt}" \
      "${source_schema}" "${implementation}" "${network}" "" "" \
      "${snapshot_root}" "${jq_path}" || return 1
  fi

  declared_count="$("${jq_path}" -er '.files | length' \
    "${snapshot_receipt}")" || return 1
  while IFS=$'\t' read -r relative_path source_path expected_mode policy \
    managed source_hash expected_hash; do
    visited_count=$((visited_count + 1))
    deployment_payload_relative_path_valid "${relative_path}" || return 1
    deployment_payload_relative_path_valid "${source_path}" || return 1
    target="${NODE_HOME}/${relative_path}"
    deployment_payload_installed_file_authority_valid \
      "${target}" "${expected_mode}" || return 1
    if [[ "${managed}" == "true" ]]; then
      actual_hash="$(deployment_payload_sha256 "${target}")" || return 1
      [[ "${actual_hash}" == "${expected_hash}" ]] || return 1
    else
      [[ "${managed}" == "false" ]] || return 1
    fi
  done < "${snapshot_root}/actual-inventory.tsv"
  [[ ${visited_count} -eq ${declared_count} ]] || return 1

  [[ ! -e "${journal}" && ! -L "${journal}" ]] || return 1
  deployment_payload_installed_file_authority_valid "${manifest}" 0644 ||
    return 1
  deployment_payload_installed_file_authority_valid "${receipt}" 0644 ||
    return 1
  [[ "$(deployment_payload_sha256 "${manifest}")" == \
       "${snapshot_manifest_hash}" &&
     "$(deployment_payload_sha256 "${receipt}")" == \
       "${snapshot_receipt_hash}" ]] || return 1
  return 0
)

deployment_payload_metadata_fingerprint() {
  local manifest
  manifest="$(deployment_file)" || return 1
  [[ -f "${manifest}" && ! -L "${manifest}" && -s "${manifest}" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  command -v sha256sum >/dev/null 2>&1 || return 1
  jq -cS . "${manifest}" 2>/dev/null | sha256sum | awk '{print $1}'
}

deployment_payload_refresh_message() {
  local message="${1:-}"
  if [[ -t 1 && $(type -t getAnswer 2>/dev/null) == "function" ]]; then
    getAnswer "${message}"
    return $?
  fi
  return 1
}

# Refresh all Guild-owned deployment files through the installed dispatcher.
# $1: Y applies without prompting; N retains the historical interactive choice.
# $2: optional branch override. All other target identity comes from metadata.
# Return: 0 no refresh, 1 complete transaction applied, 2 failure.
deployment_refresh_payload() {
  local auto_update="${1:-N}"
  local requested_branch="${2:-}"
  local manifest dispatcher metadata
  local implementation network stored_branch repository account service
  local source_mode source_dirty requested_mode node_parent node_name signature
  local before_current=N before_fingerprint="" after_fingerprint=""
  local check_status apply_status result=2
  local check_output="" checked_revision=""
  local -a dispatcher_args

  [[ "${auto_update}" == "Y" || "${auto_update}" == "N" ]] || return 2
  command -v jq >/dev/null 2>&1 || {
    printf "Cannot refresh Guild payload: jq is not available.\n" >&2
    return 2
  }
  manifest="$(deployment_file)" || return 2
  if [[ ! -f "${manifest}" || -L "${manifest}" || ! -s "${manifest}" ]]; then
    printf "Cannot refresh Guild payload: a finalized deployment manifest is required at %s. Re-run guild-deploy.sh.\n" \
      "${manifest}" >&2
    return 2
  fi
  metadata="$(jq -er '
    select(
      type == "object" and .schemaVersion == 1 and
      .deploymentStatus == "deployed" and
      (.implementation == "cnode" or .implementation == "dingo" or .implementation == "amaru") and
      (.network | type == "string" and length > 0) and
      (.branch | type == "string" and length > 0) and
      (.repository | type == "string" and test("^[A-Za-z0-9_.-]+/guild-operators$")) and
      (.serviceName | type == "string" and test("^[A-Za-z0-9_.@-]+$"))
    ) |
    [
      .implementation,
      .network,
      .branch,
      .repository,
      .serviceName,
      (.sourceMode // "managed"),
      (.sourceDirty // false)
    ] | @tsv
  ' "${manifest}" 2>/dev/null)" || {
    printf "Cannot refresh Guild payload: %s is malformed or incomplete. Re-run guild-deploy.sh.\n" \
      "${manifest}" >&2
    return 2
  }
  IFS=$'\t' read -r implementation network stored_branch repository service \
    source_mode source_dirty <<< "${metadata}"
  account="${repository%/guild-operators}"
  requested_branch="${requested_branch:-${stored_branch}}"
  deployment_branch_valid "${stored_branch}" &&
    deployment_branch_valid "${requested_branch}" || {
      printf "Cannot refresh Guild payload: deployment branch '%s' is invalid.\n" \
        "${requested_branch}" >&2
      return 2
    }
  case "${implementation}:${network}" in
    cnode:mainnet|cnode:guild|cnode:preprod|cnode:preview|dingo:preprod|dingo:preview|amaru:preprod|amaru:preview) ;;
    *)
      printf "Cannot refresh Guild payload: unsupported target %s/%s in %s.\n" \
        "${implementation}" "${network}" "${manifest}" >&2
      return 2
      ;;
  esac
  [[ "${service}" == "$(basename "${NODE_HOME}" | tr '[:upper:]' '[:lower:]')" ]] || {
    printf "Cannot refresh Guild payload: serviceName '%s' does not match target folder '%s'.\n" \
      "${service}" "$(basename "${NODE_HOME}")" >&2
    return 2
  }

  # Source modes are per invocation, not sticky deployment preferences.
  # Managed remains the default; cached must be an explicit offline choice.
  requested_mode="${GUILD_SOURCE_MODE:-managed}"
  if [[ "${source_mode}" == "local" || "${source_dirty}" == "true" ]]; then
    dispatcher="${NODE_HOME}/scripts/guild-deploy.sh"
    printf "Cannot automatically refresh a deployment installed from a local or dirty checkout. Re-run %s -i %s -n %s -p %s -t %s -b %s -a %s -S local -L /absolute/path/to/guild-operators%s\n" \
      "${dispatcher}" "${implementation}" "${network}" "$(dirname "${NODE_HOME}")" \
      "$(basename "${NODE_HOME}")" "${requested_branch}" "${account}" \
      "$([[ "${source_dirty}" == "true" ]] && printf ' -D')" >&2
    return 2
  fi
  case "${requested_mode}" in
    managed|cached) ;;
    local)
      printf "Automatic helper refresh cannot select local mode because no checkout path is stored. Re-run %s/scripts/guild-deploy.sh with -S local -L /absolute/path/to/guild-operators and -D when needed.\n" \
        "${NODE_HOME}" >&2
      return 2
      ;;
    *)
      printf "Cannot refresh Guild payload: GUILD_SOURCE_MODE must be managed or cached.\n" >&2
      return 2
      ;;
  esac

  node_parent="$(dirname "${NODE_HOME}")"
  node_name="$(basename "${NODE_HOME}")"
  signature="${repository}|${requested_branch}|${implementation}|${network}|${requested_mode}|${NODE_HOME}"
  case "${GUILD_PAYLOAD_REFRESH_STATE:-idle}" in
    complete)
      if [[ "${GUILD_PAYLOAD_REFRESH_SIGNATURE:-}" != "${signature}" ]]; then
        printf "Cannot evaluate two different Guild payload sources in one helper process; rerun the helper for '%s'.\n" \
          "${requested_branch}" >&2
        return 2
      fi
      return "${GUILD_PAYLOAD_REFRESH_RESULT:-2}"
      ;;
    running)
      printf "Recursive Guild payload refresh request refused.\n" >&2
      return 2
      ;;
    idle|"") ;;
    *)
      printf "Invalid Guild payload refresh state.\n" >&2
      return 2
      ;;
  esac
  GUILD_PAYLOAD_REFRESH_STATE="running"
  GUILD_PAYLOAD_REFRESH_SIGNATURE="${signature}"

  dispatcher="${NODE_HOME}/scripts/guild-deploy.sh"
  if [[ ! -f "${dispatcher}" || -L "${dispatcher}" || ! -s "${dispatcher}" ]]; then
    printf "Cannot refresh Guild payload: installed dispatcher is missing or unsafe at %s. Re-run guild-deploy.sh from a trusted checkout.\n" \
      "${dispatcher}" >&2
    GUILD_PAYLOAD_REFRESH_STATE="complete"
    GUILD_PAYLOAD_REFRESH_RESULT=2
    return 2
  fi
  if ! "${BASH}" -n "${dispatcher}" >/dev/null 2>&1 ||
     ! grep -q '^dispatcher_prepare_source_and_handoff()' "${dispatcher}" ||
     ! grep -q 'GUILD_SOURCE_CHECK_ONLY' "${dispatcher}" ||
     ! grep -q '^dispatcher_distribution_prepare()' "${dispatcher}"; then
    printf "Cannot refresh Guild payload: %s predates or fails the transactional source contract. Re-run a current guild-deploy.sh from a trusted checkout.\n" \
      "${dispatcher}" >&2
    GUILD_PAYLOAD_REFRESH_STATE="complete"
    GUILD_PAYLOAD_REFRESH_RESULT=2
    return 2
  fi
  dispatcher_args=(
    -i "${implementation}"
    -n "${network}"
    -p "${node_parent}"
    -t "${node_name}"
    -b "${requested_branch}"
    -a "${account}"
    -S "${requested_mode}"
    -s ""
    -u
  )
  deployment_payload_is_current && before_current=Y
  before_fingerprint="$(deployment_payload_metadata_fingerprint 2>/dev/null || true)"

  check_status=0
  check_output="$(
    unset GUILD_SOURCE_CHECKOUT GUILD_SOURCE_ALLOW_DIRTY
    unset GUILD_SOURCE_EXPECT_REVISION GUILD_DOCKER_EXPORT_ROOT
    unset GUILD_SOURCE_ALLOW_REPOSITORY_CHANGE GUILD_DEPLOY_LOCK_HELD_FOR
    unset GUILD_SOURCE_HANDOFF_ACTIVE GUILD_SOURCE_HANDOFF_SNAPSHOT
    unset GUILD_SOURCE_HANDOFF_CONTAINER GUILD_SOURCE_HANDOFF_TOKEN
    unset GUILD_SOURCE_HANDOFF_REPOSITORY GUILD_SOURCE_HANDOFF_CHANNEL
    unset GUILD_SOURCE_HANDOFF_MODE GUILD_SOURCE_HANDOFF_REF
    unset GUILD_SOURCE_HANDOFF_REVISION GUILD_SOURCE_HANDOFF_DIRTY
    unset GUILD_SOURCE_HANDOFF_TREE_DIGEST
    GUILD_SOURCE_CHECK_ONLY=Y "${BASH}" "${dispatcher}" "${dispatcher_args[@]}"
  )" || check_status=$?
  [[ -z "${check_output}" ]] || printf '%s\n' "${check_output}"
  case "${check_status}" in
    0|10)
      checked_revision="${check_output##*$'\n'}"
      if [[ ! "${checked_revision}" =~ ^[0-9a-f]{40,64}$ ]]; then
        printf "Guild source check did not return an exact revision; the installed payload was not changed.\n" >&2
        GUILD_PAYLOAD_REFRESH_STATE="complete"
        GUILD_PAYLOAD_REFRESH_RESULT=2
        return 2
      fi
      ;;
  esac
  case "${check_status}" in
    0)
      if [[ "${before_current}" == "Y" && "${requested_branch}" == "${stored_branch}" &&
            "${requested_mode}" == "${source_mode}" ]]; then
        result=0
        GUILD_PAYLOAD_REFRESH_STATE="complete"
        GUILD_PAYLOAD_REFRESH_RESULT="${result}"
        return "${result}"
      fi
      ;;
    10) ;;
    *)
      printf "Guild source check failed; the installed payload was not changed.\n" >&2
      GUILD_PAYLOAD_REFRESH_STATE="complete"
      GUILD_PAYLOAD_REFRESH_RESULT=2
      return 2
      ;;
  esac

  if [[ "${auto_update}" != "Y" ]] &&
     ! deployment_payload_refresh_message \
       "\nA complete Guild payload refresh is available for ${implementation}/${network} (${repository} ${requested_branch}, ${requested_mode}). Apply it now?"; then
    GUILD_PAYLOAD_REFRESH_STATE="complete"
    GUILD_PAYLOAD_REFRESH_RESULT=0
    return 0
  fi

  apply_status=0
  (
    unset GUILD_SOURCE_CHECK_ONLY GUILD_SOURCE_CHECKOUT GUILD_SOURCE_ALLOW_DIRTY
    unset GUILD_SOURCE_EXPECT_REVISION GUILD_DOCKER_EXPORT_ROOT
    unset GUILD_SOURCE_ALLOW_REPOSITORY_CHANGE GUILD_DEPLOY_LOCK_HELD_FOR
    unset GUILD_SOURCE_HANDOFF_ACTIVE GUILD_SOURCE_HANDOFF_SNAPSHOT
    unset GUILD_SOURCE_HANDOFF_CONTAINER GUILD_SOURCE_HANDOFF_TOKEN
    unset GUILD_SOURCE_HANDOFF_REPOSITORY GUILD_SOURCE_HANDOFF_CHANNEL
    unset GUILD_SOURCE_HANDOFF_MODE GUILD_SOURCE_HANDOFF_REF
    unset GUILD_SOURCE_HANDOFF_REVISION GUILD_SOURCE_HANDOFF_DIRTY
    unset GUILD_SOURCE_HANDOFF_TREE_DIGEST
    GUILD_SOURCE_EXPECT_REVISION="${checked_revision}" \
      "${BASH}" "${dispatcher}" "${dispatcher_args[@]}"
  ) || apply_status=$?
  if [[ "${apply_status}" -ne 0 ]] || ! deployment_payload_is_current; then
    printf "Complete Guild payload refresh failed; inspect the dispatcher output above.\n" >&2
    result=2
  else
    after_fingerprint="$(deployment_payload_metadata_fingerprint 2>/dev/null || true)"
    if [[ "${before_current}" != "Y" || -z "${before_fingerprint}" ||
          "${before_fingerprint}" != "${after_fingerprint}" ]]; then
      result=1
    else
      result=0
    fi
  fi
  GUILD_PAYLOAD_REFRESH_STATE="complete"
  GUILD_PAYLOAD_REFRESH_RESULT="${result}"
  return "${result}"
}

# A branch change is a complete source/payload transaction. Only the dispatcher
# is allowed to publish the resulting deployment metadata.
deployment_set_branch() {
  local branch="${1:-}"
  local refresh_status

  if ! deployment_branch_valid "${branch}"; then
    printf "Invalid deployment branch: '%s'\n" "${branch}" >&2
    return 2
  fi
  deployment_refresh_payload Y "${branch}"
  refresh_status=$?
  case "${refresh_status}" in
    0|1) return 0 ;;
    *) return 1 ;;
  esac
}
