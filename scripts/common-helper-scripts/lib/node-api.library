    return "${NODE_ADAPTER_UNSUPPORTED}"
  fi
  node_adapter_replay_progress
}

# Calculate local-ledger progress through an epoch. Alternate nodes expose the
# latest validated block's epoch slot, so this is deliberately not presented
# as network sync progress while the node is catching up.
node_epoch_progress_percent() {
  local epoch_slot="${1:-}"
  local epoch_size="${2:-}"

  [[ "${epoch_slot}" =~ ^[0-9]+([.][0-9]+)?$ &&
     "${epoch_size}" =~ ^[1-9][0-9]*$ ]] || return 1
  LC_NUMERIC=C awk \
    -v current_slot="${epoch_slot}" \
    -v epoch_size="${epoch_size}" '
      BEGIN {
        progress = (current_slot / epoch_size) * 100
        if (progress < 0) progress = 0
        if (progress > 100) progress = 100
        printf "%.1f", progress
      }
    '
}

common_resolve_cardano_cli() {
  [[ -z "${CCLI}" ]] && CCLI=$(command -v cardano-cli)
  if [[ -z "${CCLI}" && -x "${HOME}/.local/bin/cardano-cli" ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
    CCLI=$(command -v cardano-cli)
  fi
  if [[ -z "${CCLI}" ]]; then
    printf 'You do not have a cardano-cli binary available in %s.\n' '$PATH' >&2
    return 1
  fi
  NODE_TX_TOOL="${CCLI}"
}

# Alternate implementations do not consume cardano-node genesis JSON, but
# gLiveView still needs the immutable timing constants for the supported public
# networks. Keep these values in the common adapter boundary so each
# implementation presents the same monitoring contract.
common_configure_known_network() {
  local network="${1:-${NODE_NETWORK:-${NETWORK:-}}}"

  case "${network,,}" in
    preprod)
      NWMAGIC=1
      NETWORK_NAME="PreProd"
      SHELLEY_TRANS_EPOCH=4
      SHELLEY_GENESIS_START_SEC=1654041600
      EPOCH_LENGTH=432000
      SLOT_LENGTH=1
      ACTIVE_SLOTS_COEFF=0.05
      SLOTS_PER_KES_PERIOD=129600
      MAX_KES_EVOLUTIONS=62
      BYRON_GENESIS_START_SEC=1654041600
      BYRON_K=2160
      BYRON_SLOT_LENGTH=20000
      BYRON_EPOCH_LENGTH=21600
      KOIOS_API="https://preprod.koios.rest/api/v1"
      ;;
    preview)
      NWMAGIC=2
      NETWORK_NAME="Preview"
      SHELLEY_TRANS_EPOCH=0
      SHELLEY_GENESIS_START_SEC=1666656000
      EPOCH_LENGTH=86400
      SLOT_LENGTH=1
      ACTIVE_SLOTS_COEFF=0.05
      SLOTS_PER_KES_PERIOD=129600
      MAX_KES_EVOLUTIONS=62
      BYRON_GENESIS_START_SEC=1666656000
      BYRON_K=432
      BYRON_SLOT_LENGTH=20000
      BYRON_EPOCH_LENGTH=4320
      KOIOS_API="https://preview.koios.rest/api/v1"
      ;;
    *)
      printf "Network '%s' has no built-in monitoring constants.\n" \
        "${network:-unset}" >&2
      return 1
      ;;
  esac

  NETWORK_IDENTIFIER="--testnet-magic ${NWMAGIC}"
  NODE_NETWORK="${network,,}"
  NODE_NETWORK_MAGIC="${NWMAGIC}"
  NODE_NETWORK_NAME="${NETWORK_NAME}"
}

common_select_network() {
  read_genesis || return 1

  if [[ "${NWMAGIC}" == "764824073" ]]; then
    NETWORK_IDENTIFIER="--mainnet"
  else
    NETWORK_IDENTIFIER="--testnet-magic ${NWMAGIC}"
  fi

  case ${NWMAGIC} in
    764824073)
      [[ -z ${NETWORK_NAME} ]] && NETWORK_NAME="Mainnet"
      [[ -z ${SHELLEY_TRANS_EPOCH} ]] && SHELLEY_TRANS_EPOCH=208
      [[ -z ${KOIOS_API} ]] && KOIOS_API="https://api.koios.rest/api/v1"
      ;;
    141)
      [[ -z ${NETWORK_NAME} ]] && NETWORK_NAME="Guild"
      [[ -z ${SHELLEY_TRANS_EPOCH} ]] && SHELLEY_TRANS_EPOCH=2
      [[ -z ${KOIOS_API} ]] && KOIOS_API="https://guild.koios.rest/api/v1"
      ;;
    1)
      [[ -z ${NETWORK_NAME} ]] && NETWORK_NAME="PreProd"
      [[ -z ${SHELLEY_TRANS_EPOCH} ]] && SHELLEY_TRANS_EPOCH=4
      [[ -z ${KOIOS_API} ]] && KOIOS_API="https://preprod.koios.rest/api/v1"
      ;;
    2)
      [[ -z ${NETWORK_NAME} ]] && NETWORK_NAME="Preview"
      [[ -z ${SHELLEY_TRANS_EPOCH} ]] && SHELLEY_TRANS_EPOCH=0
      [[ -z ${KOIOS_API} ]] && KOIOS_API="https://preview.koios.rest/api/v1"
      ;;
    *)
      [[ -z ${NETWORK_NAME} ]] && NETWORK_NAME="Custom"
      [[ -z ${SHELLEY_TRANS_EPOCH} ]] && SHELLEY_TRANS_EPOCH=0
      ;;
  esac

  NODE_NETWORK_MAGIC="${NWMAGIC}"
  NODE_NETWORK_NAME="${NETWORK_NAME}"
}
